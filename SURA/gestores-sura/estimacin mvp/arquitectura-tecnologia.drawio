        </mxCell>
        <mxCell id="c-2" value="Vista de despliegue (C4 · nivel 2) del alcance dibujado en «Arquitectura MVP», realizada sobre el stack que fijan los lineamientos AI First de SURA.&lt;br&gt;Cada componente cita la página del espacio AFGLYP que lo define. Morado: lo fija el lineamiento · naranja: extrapolación nuestra sobre una herramienta del lineamiento · rojo: sin respaldo en el lineamiento." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="0" y="-128" width="3300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c-3" value="CANALES Y EXPERIENCIA" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#EFFCFF;strokeColor=#4D9DB5;strokeWidth=3;" vertex="1" parent="1">
