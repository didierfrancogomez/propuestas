        <mxCell id="e-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-15" target="c-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-33" value="GRAFO DEL GESTOR SOLICITUD · nodos del mismo StateGraph de LangGraph" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="725" width="3240" height="286" as="geometry" />
        </mxCell>
        <mxCell id="c-34" value="&lt;b&gt;Entrada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Adaptador FastAPI por tipo de solicitud&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="836" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-35" value="&lt;b&gt;Clasificador de documentos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Qué documento es cada archivo recibido&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="836" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-36" value="&lt;b&gt;Enrutador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Decide qué extractores se activan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="836" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-37" value="&lt;b&gt;Extractor historia clínica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Modelo multimodal vía LiteLLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="806" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-38" value="&lt;b&gt;Extractor orden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Modelo multimodal vía LiteLLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="886" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-39" value="&lt;b&gt;Agente request builder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Arma la solicitud con los campos con respaldo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="836" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-40" value="&lt;b&gt;LLM-as-a-judge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Verifica contrato, respaldo y confianza&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1760" y="836" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-41" value="¿Contrato&lt;br&gt;y umbral?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;verticalAlign=middle;align=center;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2100" y="811" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-42" value="&lt;b&gt;Publica evento al bus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Con canal de origen y llave de correlación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2380" y="806" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-43" value="&lt;b&gt;Escala a preradicado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Motivo, umbral aplicado y confianza obtenida&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2380" y="906" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-44" value="&lt;b&gt;El umbral es política, no constante&lt;/b&gt;&lt;br&gt;Se deriva del límite tolerable del error caro que se acuerda con el negocio, por tipo de caso, y se lee del control plane en cada ejecución." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2710" y="806" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e-45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-34" target="c-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-35" target="c-36">
