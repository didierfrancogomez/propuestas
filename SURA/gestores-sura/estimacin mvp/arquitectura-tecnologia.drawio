        </mxCell>
        <mxCell id="c-12" value='&lt;b&gt;Nexo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;strokeWidth=1;arcSize=10;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1625" y="46" width="225" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-13" value='&lt;b&gt;AVA&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;strokeWidth=1;arcSize=10;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1860" y="46" width="225" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-14" value='&lt;b&gt;Chat conversacional&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Azure Static Web App · Angular SPA, desacoplada del plano agéntico y consumiendo la plataforma por el AI Gateway.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · Experiencia e interacción&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2095" y="46" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-15" value="&lt;b&gt;Entrada gobernada&lt;/b&gt;&lt;br&gt;Todo canal entra por el AI Gateway con identidad propagada (Entra ID · OAuth2/OIDC/JWT). Cada solicitud viaja marcada con su canal de origen, para que los casos que se saltan gestores no contaminen la métrica de quien no participó." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2420" y="46" width="850" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-16" value="CONTROL PLANE · PLATAFORMA AGÉNTICA — realiza el «AI Control Plane» del dibujo del MVP" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#F7F2FF;strokeColor=#7B4FB0;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="256" width="3300" height="316" as="geometry" />
        </mxCell>
        <mxCell id="c-17" value='&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;AI Gateway. Puerta de entrada obligatoria del tráfico agéntico: autenticación con Entra ID, cuotas, rate limiting y trazabilidad.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · AI Gateway · ADR-2026-001 · 6244532291&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-18" value='&lt;b&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;MCP Tool Gateway &amp;amp; Registry. Catálogo de herramientas con dueño y contrato, allow-lists por agente y versionamiento.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · MCP Tool Gateway &amp;amp; Registry&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="438" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-19" value='&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Identidad humana y técnica. OAuth2 / OIDC / JWT, service principals y Managed Identity; autorización contextual en el gateway.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · Identidad y autenticación&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="846" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-20" value='&lt;b&gt;LiteLLM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;LLM Gateway. Routing, fallback, límites de tokens y presupuesto por gestor, agente y entorno. Desacopla el contrato del proveedor.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · LLM / Model Gateway · Diseño Datos · 5900140571&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1254" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-21" value='&lt;b&gt;Azure AI Foundry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Modelos y servicios cognitivos, con Azure AI Content Safety y Microsoft Presidio para guardrails de entrada y salida y datos personales.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · AI Security Enforcement&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1662" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-22" value='&lt;b&gt;Langfuse + PostgreSQL Flexible&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Prompt Management, versionado, evaluaciones y trazas de calidad. ClickHouse queda como prerrequisito interno, no como observabilidad. El registro de evaluaciones con golden set se apoya además en MLflow.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · AI/LLM Lifecycle · MLflow en Diseño Datos · 5900140571&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2070" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-23" value='&lt;b&gt;API de gestión y configuraciones&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Umbrales por tipo de caso, techos de autonomía y parámetros de cada agente, versionados. Publicación por pipeline, sin acceso directo a la herramienta de prompts.&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Patrón nuestro sobre APIM + PostgreSQL Flexible · 6243680318&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2478" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-24" value='&lt;b&gt;FinOps&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Políticas de APIM, presupuestos de LiteLLM y Cost Management. Costo por gestor, agente, modelo y entorno.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · FinOps&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2886" y="302" width="383" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-25" value="&lt;b&gt;Frontera del control plane en el MVP&lt;/b&gt;&lt;br&gt;Quedan fuera el A2A Gateway —el MVP no tiene colaboración entre agentes— y el catálogo MCP público completo. Apigee sigue siendo el estándar corporativo de las APIs de negocio y coexiste con APIM, que gobierna el tráfico agéntico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="487" width="3240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-26" value="DOMINIO DE AGENTES · suscripción de agentes (Azure) — runtime de los gestores" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#FBFAFF;strokeColor=#280265;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="612" width="3300" height="977" as="geometry" />
        </mxCell>
        <mxCell id="c-27" value="GESTOR SOLICITUD" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=18;fontStyle=1;fillColor=#F8F5FF;strokeColor=#280265;strokeWidth=3;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="658" width="1600" height="746" as="geometry" />
        </mxCell>
        <mxCell id="c-28" value="GESTOR EVALUACIÓN · AUTORIZACIÓN SALUD" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=18;fontStyle=1;fillColor=#F8F5FF;strokeColor=#280265;strokeWidth=3;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1670" y="658" width="1600" height="746" as="geometry" />
        </mxCell>
        <mxCell id="c-29" value="RUNTIME · AKS namespace &lt;i&gt;gestores-solicitud&lt;/i&gt; · contenedor Python (FastAPI + Uvicorn) · grafo LangGraph · OpenTelemetry" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9673A6;fontColor=#6C3483;" vertex="1" parent="1">
          <mxGeometry x="55" y="704" width="1550" height="520" as="geometry" />
        </mxCell>
        <mxCell id="c-30" value="RUNTIME · AKS namespace &lt;i&gt;gestores-evaluacion&lt;/i&gt; · contenedor Python (FastAPI + Uvicorn) · grafo LangGraph · OpenTelemetry" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9673A6;fontColor=#6C3483;" vertex="1" parent="1">
          <mxGeometry x="1695" y="704" width="1550" height="520" as="geometry" />
        </mxCell>
        <mxCell id="c-31" value='&lt;b&gt;Api orquestadora&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Orchestrator&lt;/i&gt;. Adaptador FastAPI + Uvicorn, publicado en APIM&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-32" value='&lt;b&gt;Clasificador de documentos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Specialist&lt;/i&gt; documental. Nodo LangGraph, modelo vía LiteLLM&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="323" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-33" value='&lt;b&gt;Enrutador&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Planner / Router&lt;/i&gt;. Nodo LangGraph; la ruta queda en telemetría&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="581" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-34" value='&lt;b&gt;Agente request builder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Specialist&lt;/i&gt;. Nodo LangGraph; arma la solicitud con los campos con respaldo&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="839" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-35" value='&lt;b&gt;LLM-as-a-judge&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Reviewer / Safety&lt;/i&gt;. Nodo LangGraph; valida contrato, grounding y confianza&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1097" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-36" value='&lt;b&gt;Agente auditor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Nodo LangGraph; propone cambios y no promueve nada&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Patrón nuestro sobre LangGraph + Langfuse&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1355" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-37" value='&lt;b&gt;Api orquestadora&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Orchestrator&lt;/i&gt;. Adaptador FastAPI + Uvicorn, publicado en APIM&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1705" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-38" value='&lt;b&gt;Duplicidad · solicitud equivalente&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Specialist&lt;/i&gt;. Similitud sobre el caso y su siniestro padre&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1963" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-39" value='&lt;b&gt;Información cliente&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Herramienta determinística del MCP privado sobre Domain APIs&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · MCP interno&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2221" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-40" value='&lt;b&gt;Pertinencia médica&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Specialist&lt;/i&gt; RAG. Recuperación híbrida y reranking sobre Azure AI Search&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2479" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-41" value='&lt;b&gt;Componente analítico&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Microservicio Python del dominio, invocado como herramienta&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · Application Runtime&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2737" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-42" value='&lt;b&gt;Agente auditor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Nodo LangGraph; propone cambios y no promueve nada&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Patrón nuestro sobre LangGraph + Langfuse&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2995" y="756" width="238" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c-43" value='&lt;b&gt;Extractor historia clínica&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Specialist&lt;/i&gt; de extracción estructurada. OCR con Azure Document Intelligence y razonamiento con modelos de Foundry vía LiteLLM.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Stack v0.5, prioridad obligatorio&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="916" width="238" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-44" value='&lt;b&gt;Extractor orden&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Rol &lt;i&gt;Specialist&lt;/i&gt; de extracción estructurada. Mismo par: Document Intelligence para OCR y modelo para la interpretación.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Stack v0.5, prioridad obligatorio&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="323" y="916" width="238" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-45" value='&lt;b&gt;El motor de extracción sí está fijado&lt;/b&gt;&lt;br&gt;El stack tecnológico v0.5 declara &lt;b&gt;Azure Document Intelligence&lt;/b&gt; para OCR y extracción estructurada con prioridad &lt;b&gt;obligatorio&lt;/b&gt;, y lo ubica en el pipeline de conocimiento. Por eso el extractor no llama al modelo contra el documento crudo: el OCR es determinístico y lo que razona el modelo es el texto ya estructurado. Queda por acordar si el llamado se hace desde el nodo o como herramienta del MCP privado.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos RAG / Knowledge / Memory · 5900140571 · Limpieza y normalización (Silver)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="581" y="916" width="1012" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-46" value='&lt;b&gt;Evaluación de reglas duras&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Herramienta determinística expuesta por el MCP privado, no razonamiento libre del modelo.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; PoC Control Plane · 5957550095 · Restricciones tecnológicas&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1705" y="916" width="238" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-47" value='&lt;b&gt;Modelo experto&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Microservicio del dominio, propiedad del negocio y orquestado por el agente.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · Application Runtime&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1963" y="916" width="238" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-48" value="¿Cumple&lt;br&gt;evaluación?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;verticalAlign=middle;align=center;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2221" y="916" width="238" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-49" value='&lt;b&gt;Ningún agente niega&lt;/b&gt;&lt;br&gt;La negación es determinística y se sustenta en la caché de reglas versionadas; ante la posibilidad de un rechazo el grafo escala a persona. El umbral es política por tipo de caso en el control plane, no una constante del agente. El lineamiento respalda el patrón: la matriz determinística se expone como herramienta, no se embebe en el prompt.&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Techos: decisión del negocio · patrón: PoC Control Plane · 5957550095&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2479" y="916" width="754" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-50" value='&lt;b&gt;Un desplegable, varios agentes lógicos&lt;/b&gt;&lt;br&gt;Los agentes del dibujo son nodos del mismo grafo LangGraph, no contenedores separados. El lineamiento nombra estos roles —orchestrator, planner/router, specialist, reviewer/safety y human supervisor— como patrón multiagente lógico dentro de un mismo runtime.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207 · Roles multiagente · Arq. de implementación · 6243680318&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="1111" width="1530" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-51" value='&lt;b&gt;Autonomía con techo&lt;/b&gt;&lt;br&gt;Autorización automática solo para servicios de nivel 1. En niveles 3 y 4 —médicos y especialistas—, alto costo o riesgo, el techo es supervisado. El lineamiento coincide: toda decisión de alto impacto exige confirmación humana y el rol &lt;i&gt;human supervisor&lt;/i&gt; es parte del runtime.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Techos: decisión del negocio · gate humano: PoC Control Plane · 5957550095&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1705" y="1111" width="1530" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-52" value='&lt;b&gt;MCP privado · Gestor Solicitud&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Contenedor Python o Java sobre el lego MCP, desplegado junto al runtime. Herramientas privadas del gestor: lectura de P8 y Siniestro Integral, escritura del preradicado y publicación de eventos. Se invoca por el MCP Gateway, nunca directo desde el grafo.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de impl. v1.1 · 5684887560 · Lego MCP Server · Arq. de implementación · 6243680318 · MCP interno&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="1249" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-53" value='&lt;b&gt;Golden set y correcciones · Gestor Solicitud&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Conjuntos de evaluación versionados en Langfuse y registrados en MLflow, con el almacén de evidencia detrás. Guarda la corrección estructurada —qué campo estaba mal, cuál era el valor correcto y de dónde salía— y los casos adversarios. Es la compuerta de la próxima versión.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Langfuse: 6243680318 · MLflow + LLM-as-Judge: Diseño Datos · 5900140571&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="845" y="1249" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-54" value='&lt;b&gt;MCP privado · Gestor Evaluación&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Contenedor Python o Java sobre el lego MCP. Expone las reglas duras como herramienta determinística, la consulta de información de cliente y la escritura de estados propios del gestor.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de impl. v1.1 · 5684887560 · Arq. de implementación · 6243680318 · MCP interno&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1695" y="1249" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-55" value='&lt;b&gt;Caché de reglas duras · reglas versionadas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;El lineamiento fija el &lt;b&gt;patrón&lt;/b&gt;: la matriz determinística se expone como herramienta o componente MCP y no se embebe en el prompt. No fija el almacén. Proponemos reglas versionadas como producto del dominio, con Azure Redis Cache para la caché de lectura, que el stack v0.5 declara opcional.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Patrón: PoC Control Plane · 5957550095 · Redis: Diseño Datos · 5900140571 (opcional) · almacén: extrapolación nuestra&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2485" y="1249" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-56" value='&lt;b&gt;AKS · cómputo agéntico&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Namespace por gestor, aislamiento y despliegue de los MCP privados. El lineamiento privilegia Container Apps para un agente singular liviano y AKS cuando hay varios desplegables, múltiples MCP servers o capacidades transversales compartidas: el MVP está en el segundo caso.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · Runtime agéntico en Azure Container / AKS&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="1434" width="628" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-57" value='&lt;b&gt;Azure Cosmos DB · Memory Layer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Memoria conversacional, memoria operacional —los checkpoints del grafo LangGraph— y estados propios de los gestores, como el preradicado. Acceso con PyMongo. TTL por tipo de memoria.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Diseño de Memory, prioridad obligatorio&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="683" y="1434" width="628" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-58" value='&lt;b&gt;Azure Container Registry Premium&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Imágenes del runtime y de los MCP privados. Revisiones inmutables y promoción registrada con autor, motivo y reversión inmediata.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de impl. v1.1 · 5684887560 · Capacidades operativas y de seguridad&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1336" y="1434" width="628" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-59" value='&lt;b&gt;Key Vault · Managed Identity · Private Endpoints&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Secretos y credenciales bajo enfoque zero-trust, identidad técnica sin secretos embebidos y red privada sobre VNet.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Arq. de implementación · 6243680318 · Gestión de secretos&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1989" y="1434" width="628" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-60" value='&lt;b&gt;Observabilidad del runtime&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;OpenTelemetry y OpenLLMetry en el orquestador. La PoC fija los campos: correlationId, sessionId, userId con hash, agentId, workerId, promptVersion y toolCallId. Backend: Application Insights, Log Analytics y Azure Monitor, o Dynatrace.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Arq. de implementación · 6243680318 · PoC · 5957550095&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2642" y="1434" width="628" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-61" value="TORRE DE CONTROL · alcance del MVP: capas 1 (ingesta y consolidación) y 2 (correlación y contexto)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#F2FBF1;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="1629" width="3300" height="301" as="geometry" />
        </mxCell>
        <mxCell id="c-62" value='&lt;b&gt;Bus de eventos compartido&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Un evento por cada cambio de estado, con la llave de correlación del caso y del siniestro padre, y esquema publicado y versionado con compatibilidad hacia atrás. &lt;b&gt;El lineamiento no nombra un producto de mensajería&lt;/b&gt;: la arquitectura de referencia define el contenedor «Broker / Mensajería» sin tecnología, y la de implementación solo nombra la librería de consumo, aio-pika sobre RabbitMQ. En las 40 páginas revisadas no aparece Service Bus, Event Hubs ni Kafka. La tecnología y el plazo los declara el dueño del bus.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #B00020;"&gt;&amp;#9656; Contenedor: Arq. de referencia v1.1 · 5666766913 · librería: 5684887560 · producto: sin lineamiento&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="1675" width="980" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-63" value='&lt;b&gt;1 · Ingesta y consolidación&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Contenedor Python sobre AKS. Idempotencia por llave de evento, orden y ventana para la evidencia que llega semanas después. El emisor que no cumple el esquema queda rechazado y registrado como falla del emisor.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Cómputo: 6243680318 · el contrato de eventos del negocio es recomendación nuestra&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1035" y="1675" width="700" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-64" value='&lt;b&gt;2 · Correlación y contexto&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Contenedor Python sobre AKS. Arma la vista del caso con llave única y lo agrupa bajo su siniestro padre. Es vocabulario del negocio, no señal técnica: por eso lo construye la torre y no la plataforma de observabilidad.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Cómputo: 6243680318 · la correlación del caso es recomendación nuestra&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1760" y="1675" width="700" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-65" value='&lt;b&gt;Almacén de evidencia de calidad · retención larga&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Sin muestreo, y con capacidad de reabrir un caso ya cerrado operativamente. Proponemos ADLS Gen2, que el stack v0.5 declara obligatorio como data lake y almacén documental, con índice de consulta. Separado de la traza técnica, que vive en la plataforma existente con retención corta.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Herramienta: Diseño Datos · 5900140571 · el uso para evidencia de la torre es extrapolación nuestra&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2485" y="1675" width="785" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-66" value="&lt;b&gt;Dos horizontes de retención, decididos antes de emitir el primer evento&lt;/b&gt;&lt;br&gt;La traza técnica vive lo que dure el diagnóstico de un incidente y se apoya en la plataforma de observabilidad que ya opera el ecosistema. El registro que sustenta si una decisión estuvo bien vive hasta que llegue la glosa o la reclamación, y ese no se muestrea: si la glosa que contradice una decisión cae en la fracción descartada, esa decisión queda evaluada como correcta para siempre. Guardarlo todo con el criterio corto es perder la evidencia; guardarlo todo con el criterio largo es pagar de más por telemetría que nadie vuelve a mirar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="1825" width="3240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-67" value="DOMINIO DE INFORMACIÓN Y CONOCIMIENTO · suscripción separada de la de agentes" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#FFF8F1;strokeColor=#B85C00;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="1970" width="3300" height="181" as="geometry" />
        </mxCell>
        <mxCell id="c-68" value='&lt;b&gt;Azure Container Apps Job&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Pipeline de ingesta programada: bronze, silver y gold. Es el patrón que el lineamiento marca como obligatorio y el que ya usa Insuregent. Databricks entra solo cuando el volumen lo justifica, donde el lineamiento lo declara recomendado.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Stack v0.5 · Análisis As-Is · 5821431820&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="2016" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-69" value='&lt;b&gt;Azure Document Intelligence + ADLS Gen2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;OCR y extracción estructurada en la capa silver, y almacenamiento medallion con la colección documental curada en gold. Ambos declarados obligatorios.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Stack v0.5&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="683" y="2016" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-70" value='&lt;b&gt;Azure AI Search + text-embedding-3-large&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Índice por producto de conocimiento con búsqueda híbrida HNSW, keyword y reranking semántico. Embeddings con el modelo que el lineamiento fija, de 3072 dimensiones, con versión registrada.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Stack v0.5, ambos obligatorios&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1336" y="2016" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-71" value='&lt;b&gt;MCP server de conocimiento&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Una herramienta por dominio de conocimiento, publicada y gobernada en APIM. El agente no accede al índice directamente. Catálogo en Purview o Unity Catalog.&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Knowledge APIs / MCP Tools&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1989" y="2016" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-72" value='&lt;b&gt;Frontera del dominio&lt;/b&gt;&lt;br&gt;Databricks prepara datos y no opera agentes. La separación de suscripciones entre el dominio de agentes y el de información es obligatoria, con dueños, evolución y costo distintos.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; LIN Infraestructura · 6150193162 · Arq. de impl. v1.1 · 5684887560&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2642" y="2016" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-73" value="SISTEMAS EMPRESARIALES · expuestos como Domain APIs (Apigee, API-led) y publicados como herramientas MCP en APIM" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#F3FAFD;strokeColor=#0E7DAD;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="2191" width="3300" height="191" as="geometry" />
        </mxCell>
        <mxCell id="c-74" value='&lt;b&gt;core · SuraHis &lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Sistema de registro: estado autoritativo de la autorización. Los gestores conservan sus propios estados, como el preradicado, en su capa de memoria.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;strokeWidth=2;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="2237" width="760" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-75" value='&lt;b&gt;P8 &lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Gestor documental de la solicitud.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;strokeWidth=2;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="815" y="2237" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-76" value="Storage P8" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/general/Storage_Azure_Files.svg;" vertex="1" parent="1">
          <mxGeometry x="1460" y="2252" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-77" value='&lt;b&gt;Siniestro Integral &lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Documentos de la solicitud.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;strokeWidth=2;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1595" y="2237" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-78" value="Storage" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/general/Storage_Azure_Files.svg;" vertex="1" parent="1">
          <mxGeometry x="2240" y="2252" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-79" value='&lt;b&gt;EPS &lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Consulta externa.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;strokeWidth=2;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2375" y="2237" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-80" value="&lt;b&gt;Interoperabilidad vía el core&lt;/b&gt;&lt;br&gt;El dato se pide primero a SuraHis; la conexión directa solo se justifica cuando el core no lo tiene ni lo va a tener." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2780" y="2237" width="490" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-81" value="DECISIONES, SUPUESTOS Y CONVENCIÓN" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="2422" width="3300" height="375" as="geometry" />
        </mxCell>
        <mxCell id="c-82" value="&lt;b&gt;Cómputo del runtime&lt;/b&gt;&lt;br&gt;El lineamiento fija Azure Container Apps para el agente singular liviano y señala AKS cuando la solución crece en desplegables, MCP servers o capacidades transversales compartidas. El MVP tiene dos runtimes de gestor, dos MCP privados y dos servicios de torre, así que la vista se dibuja sobre AKS. Si el alcance se reduce a un desplegable por gestor sin MCP privado propio, Container Apps vuelve a ser la opción adecuada y esta vista se ajusta sin cambiar nada más." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="2468" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-83" value="&lt;b&gt;Lo que esta vista deja explícitamente fuera&lt;/b&gt;&lt;br&gt;A2A Gateway, catálogo MCP público completo, Prompt Compiler y Policy Engine de la arquitectura deseada, y las capas 3, 4 y 5 de la torre —medición, decisión y exposición—. También los gestores de Coordinación, Prestación y Finalización, y los extractores de factura y de otros documentos. Se dibujan como frontera del MVP, no como faltante del diseño." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="846" y="2468" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-84" value="&lt;b&gt;Decisiones abiertas que conviene cerrar antes de estimar&lt;/b&gt;&lt;br&gt;Producto de mensajería del bus, que el lineamiento no nombra. Motor de políticas del guardrail de rol, que el propio lineamiento deja abierto entre Casbin y OPA. Motor de plantillas de prompt, que el lineamiento declara sin decidir entre Jinja2 y PromptTemplates. Almacén de las reglas duras versionadas y de la evidencia de retención larga. Reparto entre Langfuse y MLflow para las evaluaciones, que el lineamiento nombra en páginas distintas sin arbitrar. Habilitación de LiteLLM, Langfuse y Container Apps en el marco de IaC, que el propio lineamiento declara inexistente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1662" y="2468" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-85" value="&lt;b&gt;Fronteras que la vista respeta&lt;/b&gt;&lt;br&gt;El agente orquesta y no absorbe la lógica transaccional. Databricks prepara datos y no opera agentes. El agente llega al conocimiento solo por MCP y nunca al índice directo. Toda capacidad se expone primero como API y luego, cuando aporta, como herramienta MCP. El LLM no se consume desde el runtime sino por el gateway. Los prompts no viven como archivos del proyecto. La matriz determinística no se embebe en el prompt. La suscripción de agentes se separa de la de información y conocimiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2478" y="2468" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-86" value="&lt;b&gt;Convención de elementos&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="2624" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-87" value='&lt;b&gt;Componente agéntico&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Nodo del grafo LangGraph. Razona con un modelo.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="2692" width="628" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-88" value='&lt;b&gt;Servicio o herramienta determinística&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;API, microservicio del dominio o herramienta del MCP privado.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="683" y="2692" width="628" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-89" value='&lt;b&gt;Capacidad del control plane&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Servicio compartido de la plataforma agéntica.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1336" y="2692" width="628" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-90" value='&lt;b&gt;Nota de diseño o decisión&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Recomendación nuestra, o punto que falta cerrar.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1989" y="2692" width="628" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-91" value='&lt;b&gt;Cita de origen&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;&lt;font style="color: #6C3483;"&gt;Morado: lo fija el lineamiento&lt;/font&gt; · &lt;font style="color: #B85C00;"&gt;naranja: extrapolación nuestra&lt;/font&gt; · &lt;font style="color: #B00020;"&gt;rojo: sin respaldo&lt;/font&gt;. El número es la página del espacio AFGLYP.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2642" y="2692" width="628" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-92" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-14" target="c-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-17" target="c-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-17" target="c-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-95" value="eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-27" target="c-62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-96" value="eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-28" target="c-62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-97" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=1;dashPattern=6 6;" edge="1" parent="1" source="c-18" target="c-52">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-98" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=1;dashPattern=6 6;" edge="1" parent="1" source="c-18" target="c-54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Runtime del gestor · componentes" id="runtime-del-gestor-componentes">
    <mxGraphModel dx="2000" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c-1" value="&lt;b&gt;Runtime de un gestor · vista de componentes&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="0" y="-190" width="3300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-2" value="C4 · nivel 3 del contenedor de runtime. Todos los componentes y sus librerías están nombrados en «Arquitectura de implementación v1.1» (página 5684887560), salvo donde se indique otra cosa.&lt;br&gt;Los grafos de abajo son los del MVP, con los roles que nombra «Agentic Runtime» (página 5838045207)." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="0" y="-128" width="3300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c-3" value="RUNTIME DEL GESTOR · contenedor Python sobre AKS, imagen desde Azure Container Registry" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="1900" height="585" as="geometry" />
        </mxCell>
        <mxCell id="c-4" value='&lt;b&gt;Adaptador de API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;FastAPI + Uvicorn, validación con Pydantic. Valida la solicitud, crea o recupera la sesión e invoca al planeador. Sin lógica de negocio.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="140" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-5" value='&lt;b&gt;Event Listener&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;aio-pika. Consumo no bloqueante con backpressure, reintentos controlados, DLQ y procesamiento idempotente.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1075" y="140" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-6" value='&lt;b&gt;Planeador / Orquestador&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;LangGraph. Grafo de estados con checkpointer: decide herramientas, controla iteraciones y límites y consolida la respuesta.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1680" y="140" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-7" value='&lt;b&gt;Constructor de prompts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Plantillas versionadas servidas por Langfuse; los prompts no viven como archivos del proyecto. El motor de plantillas lo deja abierto el lineamiento entre Jinja2 y PromptTemplates de LangChain.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="270" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-8" value='&lt;b&gt;Enrutador de tools&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;LangChain tools. Analiza el estado, determina si hace falta herramienta y delega la ejecución al cliente MCP.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1075" y="270" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-9" value='&lt;b&gt;Role Policy &amp;amp; GuardRails&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Permisos del rol, herramientas permitidas y techo de autonomía vigente, leídos del control plane. Motor: decisión abierta entre Casbin y OPA.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1680" y="270" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-10" value='&lt;b&gt;Cliente LLM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;httpx + tenacity contra LiteLLM. Timeouts estrictos y backoff exponencial ante 429 y 5xx, sin bloquear el event loop.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="400" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-11" value='&lt;b&gt;Cliente MCP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;httpx. JSON-RPC sobre HTTP contra el MCP Gateway, con control de headers, auth y timeouts. Fino: transporte y contrato.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1075" y="400" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-12" value='&lt;b&gt;Manejador de sesión y contexto&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Memoria corta: historial inmediato, variables de contexto e identificadores de correlación.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1680" y="400" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-13" value='&lt;b&gt;Memory Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;PyMongo contra Cosmos DB con API Mongo, según la arquitectura de implementación v1.1. Ojo: el diseño de datos exige que la escritura pase por un Memory Writer Service con guardrails. Conflicto abierto entre las dos páginas.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="530" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-14" value='&lt;b&gt;Reintentos y manejo de errores&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;tenacity como librería transversal del runtime. Hace visible la estrategia de resiliencia y evita reintentos ad-hoc.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1075" y="530" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-15" value='&lt;b&gt;Telemetría y auditoría&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;OpenTelemetry y OpenLLMetry. Campos que fija la PoC: correlationId, sessionId, userId con hash, agentId, workerId, promptVersion y toolCallId.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1680" y="530" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-16" value='&lt;b&gt;Azure API Management · AI Gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Autenticación con Entra ID, cuotas, rate limiting y trazabilidad. Punto de entrada obligatorio del tráfico agéntico.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-17" value='&lt;b&gt;Broker de eventos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Cambios de estado del ciclo, con la llave de correlación del caso y del siniestro padre.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="260" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-18" value="&lt;b&gt;Identidad propagada&lt;/b&gt;&lt;br&gt;El usuario, el canal, el agente y su versión viajan en cada llamada y quedan en la traza. Sin eso no hay auditoría de punta a punta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="365" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-19" value='&lt;b&gt;LiteLLM → Azure AI Foundry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;LLM Gateway y proveedor gobernado de modelos, con Content Safety y Presidio.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2320" y="140" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-20" value='&lt;b&gt;APIM · MCP Tool Gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Control de acceso centralizado a los MCP servers, con allow-lists por agente.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2320" y="222" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-21" value='&lt;b&gt;MCP privado · MCP de conocimiento&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Herramientas privadas del gestor y acceso al conocimiento sobre Azure AI Search.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2320" y="304" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-22" value='&lt;b&gt;Azure Cosmos DB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Memoria durable y estados propios del gestor.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2320" y="386" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-23" value='&lt;b&gt;Langfuse + PostgreSQL Flexible&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Prompts versionados, evaluaciones y golden set del gestor.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2320" y="468" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-24" value='&lt;b&gt;App Insights · Log Analytics · Monitor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Traza técnica de corta retención, para diagnóstico de incidentes.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2320" y="550" width="950" height="60" as="geometry" />
        </mxCell>
