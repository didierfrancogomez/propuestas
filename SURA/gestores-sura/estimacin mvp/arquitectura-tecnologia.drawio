        <mxCell id="c-1" value="&lt;b&gt;Arquitectura de tecnología del MVP de Gestores&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=32;" vertex="1" parent="1">
