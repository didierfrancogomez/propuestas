        <mxCell id="c-55" value="GRAFO DEL GESTOR EVALUACIÓN · AUTORIZACIÓN SALUD" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
