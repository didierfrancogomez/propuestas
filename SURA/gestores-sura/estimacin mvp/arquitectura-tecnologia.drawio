        <mxCell id="c-57" value="¿Solicitud&lt;br&gt;equivalente?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;verticalAlign=middle;align=center;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="1157" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-58" value='&lt;b&gt;Información cliente&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Herramienta determinística del MCP privado&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="1174" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-59" value='&lt;b&gt;Evaluación de reglas duras&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Determinística, sobre la caché de reglas versionadas&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="1174" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-60" value='&lt;b&gt;Pertinencia médica&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Recuperación sobre Azure AI Search&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1174" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-61" value='&lt;b&gt;Componente analítico · modelo experto&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Microservicios del dominio, invocados como herramienta&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1610" y="1174" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-62" value="¿Cumple&lt;br&gt;evaluación?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;verticalAlign=middle;align=center;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1940" y="1157" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-63" value='&lt;b&gt;Aprobada&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Publica el evento y el estado al core&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2210" y="1132" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-64" value='&lt;b&gt;Escala a evaluación humana&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;El estado nombra lo que el caso es&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2210" y="1232" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-65" value="&lt;b&gt;Negar es de la persona&lt;/b&gt;&lt;br&gt;Si el agente cree que el caso es candidato a negación, lo señala y escala. La negación es determinística y trazable, nunca probabilística. El posible duplicado también escala, con la evidencia de a cuál se parece; acierto y falsos positivos se miden por separado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2540" y="1132" width="730" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e-66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-56" target="c-57">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-57" target="c-58">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-58" target="c-59">
