        <mxCell id="c-157" value="Definido en el stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2290" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-158" value="Apigee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2354" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-159" value="Domain APIs de negocio de SuraHis, P8, Siniestro Integral y EPS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2354" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-160" value="Arquitectura de implementación&lt;br&gt;6243680318 · 2026-08-28&lt;br&gt;ADRs de Implementación&lt;br&gt;6244532291 · 2026-08-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2354" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-161" value="«mantener APIGEE como estándar para APIs de negocio y exposición a aliados». Y: «Ambas capas coexisten con responsabilidades diferenciadas»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2354" width="1120" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-162" value="Definido en el stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2354" width="420" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-163" value="Políticas APIM + presupuestos LiteLLM&lt;br&gt;+ Cost Management" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2439" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-164" value="Costo por gestor, agente, modelo y entorno." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2439" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-165" value="Arquitectura de implementación&lt;br&gt;6243680318 · 2026-08-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2439" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-166" value="«FinOps | APIM policies + LiteLLM + Cost Management | Enforcement de consumo y análisis de costos»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2439" width="1120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-167" value="Definido en el stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2439" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-168" value="Lego MCP Server (Java o Python)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2503" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-169" value="Base de los MCP privados de los dos gestores." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2503" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-170" value="Arquitectura de implementación v1.1&lt;br&gt;5684887560 · 2026-03-17&lt;br&gt;Arquitectura de implementación&lt;br&gt;6243680318 · 2026-08-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2503" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-171" value="Define dos legos, «Lego MCP Server en Java» y «Lego MCP Server en Python», este último «para construir servidores MCP (Model-Connector-Provider pattern) en Python». Y: «Los MCP internos del agente se despliegan junto al runtime en AKS»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2503" width="1120" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-172" value="Definido en el stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2503" width="420" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-173" value="Separación de suscripciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2588" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-174" value="El dominio de agentes y el de conocimiento van en suscripciones distintas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2588" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-175" value="[LIN] Separación de Suscripciones&lt;br&gt;6150193162 · 2026-07-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2588" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-176" value="«Toda solución de IA deberá implementar una separación explícita entre las suscripciones que soportan las capacidades de agentes y aquellas que soportan los activos de información o conocimiento»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2588" width="1120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-177" value="&lt;b&gt;Obligatorio&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2588" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-178" value="Roles del grafo&lt;br&gt;orchestrator · planner · specialist · reviewer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2652" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-179" value="Nombran los nodos de los dos gestores del MVP." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2652" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-180" value="Agentic Runtime&lt;br&gt;5838045207 · 2026-07-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2652" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-181" value="«Orchestrator… Planner / Router… Specialist Agent… Reviewer / Safety Agent… Human Supervisor». Entre los ejemplos de specialist: «Especialista de extracción estructurada», «Especialista RAG», «Especialista de validación determinística»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2652" width="1120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-182" value="Definido en el stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2652" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-183" value="Producto de mensajería del bus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2716" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-184" value="Transporte de los eventos del ciclo de la solicitud." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2716" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-185" value="Arquitectura de Referencia V1.1&lt;br&gt;5666766913 · 2026-04-01&lt;br&gt;Arquitectura de implementación v1.1&lt;br&gt;5684887560 · 2026-03-17" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2716" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-186" value="La referencia define el contenedor «Broker / Mensajería» sin nombrar producto. La implementación solo nombra la librería de consumo. En las 40 páginas del espacio no aparece Service Bus, Event Hubs ni Kafka." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2716" width="1120" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-187" value='&lt;font style="color: #B00020;"&gt;&lt;b&gt;Sin respaldo&lt;/b&gt;&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2716" width="420" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c-188" value="Almacén de reglas duras versionadas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2801" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-189" value="Sustenta la negación determinística y trazable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2801" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-190" value="PoC Control Plane&lt;br&gt;5957550095 · 2026-06-04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2801" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-191" value="El lineamiento fija el patrón, no el almacén. La restricción es «La matriz no debe quedar embebida como lógica no gobernada en el prompt.» y su implicación, «Debe exponerse como tool determinística, servicio interno o componente MCP.»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2801" width="1120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-192" value='&lt;font style="color: #B85C00;"&gt;&lt;b&gt;Extrapolación nuestra&lt;/b&gt;&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2801" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-193" value="Almacén de evidencia de retención larga" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2865" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-194" value="Guarda sin muestreo lo que sustenta si una decisión estuvo bien." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2865" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-195" value="Diseño Datos RAG / Knowledge / Memory&lt;br&gt;5900140571 · 2026-05-11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2865" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-196" value="La herramienta que proponemos, ADLS Gen2, sí está en el lineamiento. Su uso como almacén de evidencia de la torre es recomendación nuestra: el lineamiento no contempla la torre de control." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2865" width="1120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-197" value='&lt;font style="color: #B85C00;"&gt;&lt;b&gt;Extrapolación nuestra&lt;/b&gt;&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2865" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-198" value="Contrato de eventos del negocio&lt;br&gt;y correlación del caso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="2929" width="480" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-199" value="Las dos capas del MVP de la torre." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="2929" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-200" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2929" width="720" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-201" value="No hay lineamiento: es el aporte propio de la torre. Las plataformas de observabilidad resuelven la traza técnica, no el vocabulario del negocio ni la ventana de evidencia rezagada." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2929" width="1120" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-202" value='&lt;font style="color: #B85C00;"&gt;&lt;b&gt;Extrapolación nuestra&lt;/b&gt;&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3040" y="2929" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c-203" value="&lt;b&gt;Cómo se hizo esta verificación&lt;/b&gt;&lt;br&gt;Se recorrieron las 40 páginas del espacio AFGLYP descargadas el 5 de septiembre de 2026, buscando cada herramienta del diseño una por una. Se verificó además que las 77 citas de este documento sean textuales. Las filas con fondo claro son las cuatro que &lt;b&gt;no&lt;/b&gt; se pudieron respaldar del todo: el producto de mensajería del bus, sin tecnología en ninguna página, y tres usos que son extrapolación nuestra sobre herramientas que el lineamiento sí nombra. Ninguna herramienta del diseño quedó sin verificar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="3033" width="3460" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Hallazgos de la auditoría" id="hallazgos-de-la-auditor-a">
    <mxGraphModel dx="2000" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c-1" value="&lt;b&gt;Hallazgos de la auditoría del stack&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="0" y="-190" width="3300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-2" value="Qué cambió al contrastar el diseño contra las 40 páginas del lineamiento, qué encontramos en desacuerdo dentro del propio lineamiento, y qué queda sin respaldo.&lt;br&gt;Esto es conversación de trabajo: sirve para cerrar decisiones antes de estimar." style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="0" y="-128" width="3300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c-3" value="1 · CORRECCIONES QUE ESTA AUDITORÍA INTRODUJO EN EL DISEÑO" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#FFF4F4;strokeColor=#B00020;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="3300" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c-4" value='&lt;b&gt;El motor de extracción documental sí estaba fijado&lt;/b&gt;&lt;br&gt;Antes decíamos que el lineamiento no fijaba motor de OCR y asumíamos extracción con modelos multimodales. Es falso: el stack tecnológico v0.5 declara &lt;b&gt;Azure Document Intelligence&lt;/b&gt; para OCR y extracción estructurada con prioridad obligatorio. Los extractores de historia clínica y de orden se corrigieron: OCR determinístico primero, modelo después sobre el texto ya estructurado.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos RAG / Knowledge / Memory · 5900140571&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-5" value='&lt;b&gt;Nombramos productos de bus que el lineamiento no nombra&lt;/b&gt;&lt;br&gt;Nuestra versión anterior decía, con palabras propias, que en Azure la alternativa natural era Service Bus o Event Hubs. Ninguno de los dos aparece en las 40 páginas, ni Kafka. Se eliminó la afirmación y se marcó el producto de mensajería como el único punto del diseño &lt;b&gt;sin respaldo&lt;/b&gt; en el lineamiento.&lt;br&gt;&lt;font style="font-size: 10px; color: #B00020;"&gt;&amp;#9656; Verificado por búsqueda en las 40 páginas del espacio&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="846" y="46" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-6" value='&lt;b&gt;Faltaban herramientas obligatorias del pipeline de conocimiento&lt;/b&gt;&lt;br&gt;El diseño ponía Databricks al frente. El lineamiento declara obligatorio &lt;b&gt;Azure Container Apps Job&lt;/b&gt; para la ingesta programada y deja Databricks como recomendado solo en volúmenes altos. Se agregaron además &lt;b&gt;text-embedding-3-large&lt;/b&gt; y el catálogo en &lt;b&gt;Purview o Unity Catalog&lt;/b&gt;, que faltaban.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · Análisis As-Is · 5821431820&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1662" y="46" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-7" value='&lt;b&gt;Faltaban MLflow, OpenLLMetry y los campos de traza&lt;/b&gt;&lt;br&gt;Las evaluaciones con golden set las atribuíamos solo a Langfuse; el lineamiento también nombra &lt;b&gt;MLflow + LLM-as-Judge&lt;/b&gt; como motor de evaluación. La observabilidad es &lt;b&gt;OpenTelemetry + OpenLLMetry&lt;/b&gt;, y la PoC fija los campos exactos de la traza: correlationId, sessionId, userId con hash, agentId, workerId, promptVersion y toolCallId.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Diseño Datos · 5900140571 · PoC Control Plane · 5957550095&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2478" y="46" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-8" value="2 · DESACUERDOS DENTRO DEL PROPIO LINEAMIENTO, QUE ALGUIEN TIENE QUE ARBITRAR" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#FFF8E8;strokeColor=#D6B656;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="261" width="3300" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c-9" value='&lt;b&gt;¿El agente escribe la memoria directo, o por un servicio?&lt;/b&gt;&lt;br&gt;«Arquitectura de implementación v1.1» pone un Memory Manager con PyMongo escribiendo contra Cosmos DB. «Diseño Datos RAG / Knowledge / Memory» dice lo contrario: «Memory Writer Service… Agente NO escribe directo en store», con filtro de inyección y detección de datos personales antes de escribir. El MVP dibuja el Memory Manager de v1.1 y deja el conflicto señalado. Cambia el esfuerzo: un servicio de escritura con guardrails es trabajo adicional.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; 5684887560 frente a 5900140571&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="307" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-10" value='&lt;b&gt;¿Langfuse o MLflow para las evaluaciones?&lt;/b&gt;&lt;br&gt;El control plane fija Langfuse para prompts, evaluaciones y trazas de calidad. El diseño de datos fija MLflow como &lt;i&gt;eval engine&lt;/i&gt; con LLM-as-Judge, y el As-Is lo posiciona como registro de experimentos. Las dos páginas no se contradicen, pero tampoco reparten el trabajo. Para el golden set del MVP hay que decidir cuál es el registro autoritativo de una corrida.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; 6243680318 frente a 5900140571 y 5821431820&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="846" y="307" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-11" value='&lt;b&gt;¿AKS o Container Apps para el runtime?&lt;/b&gt;&lt;br&gt;«Arquitectura de implementación v1.1» define Container Apps para el agente singular y descarta Web Apps. La página de la plataforma agéntica pone AKS en la tabla del Agent Runtime, y admite Container Apps «para agentes singulares y livianos». El criterio de transición sí es claro y por eso el MVP se dibuja sobre AKS, pero la ratificación no está escrita.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; 5684887560 frente a 6243680318&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1662" y="307" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-12" value='&lt;b&gt;El gateway del control plane todavía es una propuesta&lt;/b&gt;&lt;br&gt;El ADR-2026-001 que adopta APIM sigue en estado &lt;b&gt;[Propuesto]&lt;/b&gt;: «Preferencia técnica por APIM, pendiente de ratificación estratégica», con decisiones abiertas de modelo operativo, postura multinube y exposición a aliados. Todo el diseño se apoya en él. Si la ratificación cambia, cambia la capa de entrada del MVP.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; ADRs de Implementación · 6244532291&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2478" y="307" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-13" value="3 · LO QUE EL PROPIO LINEAMIENTO DEJA ABIERTO, Y NOSOTROS NO PODEMOS CERRAR" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#F4F8FF;strokeColor=#3A5FCD;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="522" width="3300" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c-14" value='&lt;b&gt;Motor de políticas del guardrail de rol&lt;/b&gt;&lt;br&gt;El lineamiento dice «Casbin, OPA, etc.» y «evolución hacia motores de política como Casbin u OPA». No elige. El MVP necesita uno desde el primer día porque el techo de autonomía se aplica por rol.&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; 5684887560 · 5838045207&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="568" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-15" value='&lt;b&gt;Motor de plantillas de prompt&lt;/b&gt;&lt;br&gt;«Aunque aún no se ha decido una tecnología concreta, algunas opciones son» —textual, con la errata— y lista «Jinja2» y «o PromptTemplates de LangChain». La elección no cambia la arquitectura, pero sí el detalle de construcción.&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; 5684887560&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="846" y="568" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-16" value='&lt;b&gt;Habilitación en el marco de IaC&lt;/b&gt;&lt;br&gt;El propio lineamiento advierte que Container Apps «Requiere habilitación específica en el framework de IaC (No existe aún)». LiteLLM y Langfuse son componentes open que se despliegan por cuenta propia, y el análisis de licenciamiento advierte que no se pueden usar las características de LiteLLM Enterprise sin licencia comercial vigente.&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; 5684887560 · Validación de licenciamiento · 6266486824&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1662" y="568" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-17" value='&lt;b&gt;Lo que aporta la torre no tiene lineamiento&lt;/b&gt;&lt;br&gt;El contrato de eventos del negocio, la correlación del caso con su siniestro padre y la ventana de evidencia rezagada no aparecen en ninguna de las 40 páginas. Es aporte propio y así se presenta: recomendación debatible, no cumplimiento de norma.&lt;br&gt;&lt;font style="font-size: 10px; color: #B85C00;"&gt;&amp;#9656; Verificado en las 40 páginas&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2478" y="568" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-18" value="4 · ALINEACIÓN QUE LA AUDITORÍA CONFIRMÓ" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fontSize=19;fontStyle=1;fillColor=#F2FBF1;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="0" y="783" width="3300" height="221" as="geometry" />
        </mxCell>
        <mxCell id="c-19" value='&lt;b&gt;Los agentes del dibujo son los roles del lineamiento&lt;/b&gt;&lt;br&gt;El MVP no inventó una taxonomía. La api orquestadora es el &lt;i&gt;orchestrator&lt;/i&gt;, el enrutador es el &lt;i&gt;planner / router&lt;/i&gt;, los extractores y la pertinencia médica son &lt;i&gt;specialists&lt;/i&gt; —el lineamiento nombra literalmente «especialista de extracción estructurada», «especialista RAG» y «especialista de validación determinística»—, el LLM-as-a-judge es el &lt;i&gt;reviewer / safety&lt;/i&gt; y la escalada a persona es el &lt;i&gt;human supervisor&lt;/i&gt;.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Agentic Runtime · 5838045207 · Roles multiagente&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="829" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-20" value='&lt;b&gt;Las restricciones de la PoC coinciden con lo que ya proponíamos&lt;/b&gt;&lt;br&gt;«La matriz no debe quedar embebida como lógica no gobernada en el prompt.», que implica «Debe exponerse como tool determinística, servicio interno o componente MCP.». «Los prompts no deben estar como archivos internos del proyecto.». «El LLM no debe consumirse directamente desde el runtime.». «Toda recomendación de riesgo alto requiere confirmación humana». Son, una por una, las decisiones del MVP.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; PoC Control Plane · 5957550095 · Restricciones&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="846" y="829" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-21" value='&lt;b&gt;El caso de negocio ya está en el inventario del cliente&lt;/b&gt;&lt;br&gt;El Análisis As-Is lista «Autorizaciones EPS» entre los proyectos con arquitectura de IA generativa más robusta en producción, y describe el patrón Insuregent —pipeline como Container Apps Job, medallion, embeddings de 3072 dimensiones y un MCP server con una herramienta por dominio— como el patrón evolucionado a replicar. Conviene mirar qué de eso se reutiliza antes de estimar construcción nueva.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Análisis As-Is · 5821431820&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1662" y="829" width="791" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-22" value='&lt;b&gt;Ninguna herramienta del diseño quedó inventada&lt;/b&gt;&lt;br&gt;Las &lt;b&gt;33 herramientas&lt;/b&gt; que nombra la vista están todas en el lineamiento, cada una con su página y su cita textual. Ninguna es invención nuestra. Lo único sin respaldo no es una herramienta sino una pieza que el lineamiento deja sin tecnología: el producto de mensajería del bus. Tres usos son extrapolación nuestra sobre herramientas que sí están en el stack: Redis para la caché de reglas duras, ADLS Gen2 para la evidencia de retención larga y APIM con PostgreSQL para la api de configuración.&lt;br&gt;&lt;font style="font-size: 10px; color: #6C3483;"&gt;&amp;#9656; Ver la pestaña «Trazabilidad del stack»&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2478" y="829" width="791" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
