        <mxCell id="c-201" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" value="No hay lineamiento: es el aporte propio de la torre. Las plataformas de observabilidad resuelven la traza técnica, no el vocabulario del negocio ni la ventana de evidencia rezagada." vertex="1">
          <mxGeometry height="64" width="1120" x="1920" y="2929" as="geometry" />
        </mxCell>
        <mxCell id="c-202" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" value="&lt;font style=&quot;color: #B85C00;&quot;&gt;&lt;b&gt;Extrapolación nuestra&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="420" x="3040" y="2929" as="geometry" />
        </mxCell>
        <mxCell id="c-203" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" value="&lt;b&gt;Cómo se hizo esta verificación&lt;/b&gt;&lt;br&gt;Se recorrieron las 40 páginas del espacio AFGLYP descargadas el 5 de septiembre de 2026, buscando cada herramienta del diseño una por una. Se verificó además que las 77 citas de este documento sean textuales. Las filas con fondo claro son las cuatro que &lt;b&gt;no&lt;/b&gt; se pudieron respaldar del todo: el producto de mensajería del bus, sin tecnología en ninguna página, y tres usos que son extrapolación nuestra sobre herramientas que el lineamiento sí nombra. Ninguna herramienta del diseño quedó sin verificar." vertex="1">
          <mxGeometry height="80" width="3460" y="3033" as="geometry" />
        </mxCell>
