        <mxCell id="c-26" value="«Modelos y cognitivos | Azure AI Foundry | Proveedor gobernado de modelos y servicios de seguridad y contenido». En v1.1: Foundry «cumple esa función» de LLM Gateway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
