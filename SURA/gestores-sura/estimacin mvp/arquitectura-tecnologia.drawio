        </mxCell>
        <mxCell id="c-36" value="«Se implementa con Langfuse, apoyado en PostgreSQL Flexible. ClickHouse se usa únicamente como prerrequisito técnico interno de Langfuse y no debe tratarse como una capacidad independiente de observabilidad»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
