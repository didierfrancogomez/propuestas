        <mxCell id="c-11" value='&lt;b&gt;WhatsApp&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;[Software System]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;strokeWidth=1;arcSize=10;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
