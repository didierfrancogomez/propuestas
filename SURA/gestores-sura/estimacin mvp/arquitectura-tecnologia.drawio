        <mxCell id="c-156" value="«La experiencia conversacional se materializa en una Static Web App basada en Angular SPA, desacoplada del plano agéntico»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
