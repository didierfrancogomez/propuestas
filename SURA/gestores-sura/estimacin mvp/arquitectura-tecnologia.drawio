        <mxCell id="e-72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-62" target="c-63">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-62" target="c-64">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-74" value="CICLO DE AUDITORÍA Y PROMOCIÓN · el mismo en los dos gestores" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="1377" width="3240" height="201" as="geometry" />
        </mxCell>
        <mxCell id="c-75" value="&lt;b&gt;Agente auditor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Observa escaladas y correcciones y propone cambios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1458" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-76" value="&lt;b&gt;Versión candidata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;No toca producción. Prompt o configuración versionada en Langfuse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="1458" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-77" value="&lt;b&gt;Compuerta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Suite contra el golden set del gestor, con criterio de no regresión. Corre en el pipeline, no en el runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="1458" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-78" value="&lt;b&gt;Promoción registrada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Autor, motivo y reversión inmediata. Imagen en ACR y prompt en Langfuse quedan atados a la misma versión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1458" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-79" value="&lt;b&gt;El auditor propone; la compuerta decide&lt;/b&gt;&lt;br&gt;Ningún cambio originado en el auditor llega a producción sin resultado de suite adjunto, y el despliegue falla si no viene. El LLM-as-a-judge se calibra contra una muestra revisada por personas expertas, y ese nivel de coincidencia se reporta junto a cualquier métrica que dependa de él." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1458" width="1610" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e-80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-75" target="c-76">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-76" target="c-77">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;" edge="1" parent="1" source="c-77" target="c-78">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
