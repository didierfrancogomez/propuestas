        <mxCell id="c-33" value="Langfuse + PostgreSQL Flexible&lt;br&gt;ClickHouse interno" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;" vertex="1" parent="1">
