  <diagram id="d0" name="Vista general">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2200" pageHeight="1700" background="#ffffff" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="vg-title" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=22;fontFamily=Helvetica;align=left;verticalAlign=top;" value='&lt;b&gt;Vista general — arquitectura de gestores&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px" color="#555555"&gt;El &lt;b&gt;canal&lt;/b&gt; radica → &lt;b&gt;Siniestro integral&lt;/b&gt; dirige el proceso y sus estados → el &lt;b&gt;orquestador de integración&lt;/b&gt; recibe HTTP, responde ACK y entrega cada mensaje en la cola del destino → los &lt;b&gt;gestores&lt;/b&gt; no se hablan entre sí y usan la plataforma agéntica compartida → los &lt;b&gt;cores&lt;/b&gt; aplican reglas, radican y aprueban → todos envían su trazabilidad a la &lt;b&gt;Torre de control&lt;/b&gt; · píldoras: &lt;b&gt;→ IA&lt;/b&gt; = LLM Gateway · &lt;b&gt;→ MCP&lt;/b&gt; = MCP Gateway · &lt;b&gt;→ Torre de control&lt;/b&gt; = trazabilidad al Kafka interno · &lt;b&gt;comandos siempre por RabbitMQ&lt;/b&gt; · &lt;b&gt;trazabilidad siempre por Kafka&lt;/b&gt;&lt;/font&gt;' vertex="1"><mxGeometry x="80" y="0" width="2330" height="70" as="geometry" /></mxCell><mxCell id="vg-l1" parent="1" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Helvetica;" value="1. CANALES" vertex="1"><mxGeometry x="80" y="100" width="2330" height="130" as="geometry" /></mxCell><mxCell id="vg-svp" parent="vg-l1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#f7f7f7;strokeColor=#43a047;rounded=1;spacing=6;" value="SVP" vertex="1"><mxGeometry x="70" y="40" width="150" height="52" as="geometry" /></mxCell><mxCell id="vg-ava" parent="vg-l1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#f7f7f7;strokeColor=#43a047;rounded=1;spacing=6;" value="AVA" vertex="1"><mxGeometry x="240" y="40" width="150" height="52" as="geometry" /></mxCell><mxCell id="vg-portal" parent="vg-l1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#f7f7f7;strokeColor=#43a047;rounded=1;spacing=6;" value="Portal prestador" vertex="1"><mxGeometry x="410" y="40" width="150" height="52" as="geometry" /></mxCell><mxCell id="vg-c-note" parent="vg-l1" style="text;html=1;whiteSpace=wrap;fontColor=#555555;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;" value="Front del usuario final: radica la solicitud y carga los documentos · &lt;b&gt;consulta el estado&lt;/b&gt; en Siniestro integral y &lt;b&gt;notifica&lt;/b&gt; al usuario · no tiene IA" vertex="1"><mxGeometry x="720" y="40" width="620" height="52" as="geometry" /></mxCell><mxCell id="vg-apigee" parent="vg-l1" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontStyle=0;fontColor=#1a1a1a;aspect=fixed;pointerEvents=1;shape=mxgraph.gcp3.apigee;fillColor=#4285f4;labelPerimeter=1;fontFamily=Helvetica;" value="Apigee" vertex="1"><mxGeometry x="620" y="42" width="50" height="48.74" as="geometry" /></mxCell><mxCell id="vg-l1-tc" parent="vg-l1" style="rounded=1;arcSize=50;html=1;fillColor=#fdf0db;strokeColor=#e08a1e;fontColor=#b35c00;fontSize=10;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" value="→ Torre de control" vertex="1"><mxGeometry x="2190" y="8" width="125" height="18" as="geometry" /></mxCell><mxCell id="vg-l2" parent="1" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#0288d1;strokeWidth=2;fontColor=#1a1a1a;fontStyle=1;fontS