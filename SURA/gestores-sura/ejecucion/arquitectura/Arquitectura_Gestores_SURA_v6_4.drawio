        </mxCell>
        <mxCell id="c40" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Microservicio&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Escenario&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Criterio&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Lo revisa&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Peso&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Solicitud&lt;/td&gt;&lt;td&gt;Salud · ambulatorio&lt;/td&gt;&lt;td&gt;La orden tiene un CUPS válido&lt;/td&gt;&lt;td&gt;código&lt;/td&gt;&lt;td&gt;obligatorio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Solicitud&lt;/td&gt;&lt;td&gt;Salud · ambulatorio&lt;/td&gt;&lt;td&gt;La cédula de la orden es la del paciente&lt;/td&gt;&lt;td&gt;código&lt;/td&gt;&lt;td&gt;obligatorio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Solicitud&lt;/td&gt;&lt;td&gt;Salud · todos&lt;/td&gt;&lt;td&gt;Las páginas marcadas como HC sí son HC&lt;/td&gt;&lt;td&gt;modelo&lt;/td&gt;&lt;td&gt;0,3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Solicitud&lt;/td&gt;&lt;td&gt;Salud · quirúrgico&lt;/td&gt;&lt;td&gt;La HC trae la justificación del procedimiento&lt;/td&gt;&lt;td&gt;modelo&lt;/td&gt;&lt;td&gt;0,4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Evaluación&lt;/td&gt;&lt;td&gt;Todos&lt;/td&gt;&lt;td&gt;La evidencia citada existe en el documento (no inventada)&lt;/td&gt;&lt;td&gt;código&lt;/td&gt;&lt;td&gt;obligatorio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Evaluación&lt;/td&gt;&lt;td&gt;Todos&lt;/td&gt;&lt;td&gt;La recomendación se sostiene con la evidencia citada&lt;/td&gt;&lt;td&gt;modelo&lt;/td&gt;&lt;td&gt;0,6&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="180" y="785" width="1180" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;{&lt;br&gt;&amp;nbsp;&quot;microservicio&quot;: &quot;solicitud&quot;,&lt;br&gt;&amp;nbsp;&quot;escenario&quot;: &quot;salud-quirurgico&quot;,&lt;br&gt;&amp;nbsp;&quot;version&quot;: &quot;1.3&quot;,&lt;br&gt;&amp;nbsp;&quot;criterios&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;id&quot;:&quot;cups_valido&quot;,&quot;tipo&quot;:&quot;codigo&quot;,&quot;obligatorio&quot;:true},&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;id&quot;:&quot;hc_justifica&quot;,&quot;tipo&quot;:&quot;modelo&quot;,&quot;peso&quot;:0.4}&lt;br&gt;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&quot;umbral_aprueba&quot;: 0.85,&lt;br&gt;&amp;nbsp;&quot;zona_gris&quot;: [0.6, 0.85]&lt;br&gt;}&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Georgia;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#8e5cc4;rounded=1;spacing=10;" vertex="1" parent="1">
