          <Array as="points"><mxPoint x="1945" y="1005" /><mxPoint x="1945" y="214" /><mxPoint x="1225" y="214" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="c54" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;" value='&lt;table border="1" cellpadding="4" style="border-collapse:collapse;width:100%;font-size:12px"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th style="background:#dae8fc"&gt;Entrada / salida&lt;/th&gt;&lt;th style="background:#dae8fc"&gt;Por dónde&lt;/th&gt;&lt;th style="background:#dae8fc"&gt;Qué viaja&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;① Entrada: el orquestador de integración lo activa&lt;/td&gt;&lt;td&gt;mensaje en la cola RabbitMQ del gestor (orquestador de integración → topic de gestor de solicitudes → cola del gestor)&lt;/td&gt;&lt;td&gt;id del siniestro padre (trazabilidad), id solicitud, referencias a los documentos en el gestor documental (orden + HC), tipo de solicitud, consumidor · un mensaje por solicitud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;② Paso interno&lt;/td&gt;&lt;td&gt;cola interna q.extraccion&lt;/td&gt;&lt;td&gt;id solicitud, páginas válidas (leídas en línea del gestor documental de Siniestro integral)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;③ Salida: solicitud lista&lt;/td&gt;&lt;td&gt;JSON por HTTP al orquestador de integración (vía Apigee) → topic → cola que lee Siniestro integral&lt;/td&gt;&lt;td&gt;datos extraídos, confianza por campo, evidencia, nota del juez&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;③b Salida: requiere revisión&lt;/td&gt;&lt;td&gt;igual que ③&lt;/td&gt;&lt;td&gt;qué falta o qué no aprobó el juez · el Core asigna a una persona&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⚠ Salida: archivo no procesable&lt;/td&gt;&lt;td&gt;igual que ③&lt;/td&gt;&lt;td&gt;respuesta &lt;b&gt;requiere revisión humana&lt;/b&gt; · motivo: fallo en la validación de archivos de entrada (dañado o con clave)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;' vertex="1">
          <mxGeometry height="230" width="1180" x="80" y="1590.0" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#43a047;rounded=1;spacing=10;" value="&lt;b&gt;⚖ Cómo funciona el juez del microservicio (muy barato)&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Chequeos con código&lt;/b&gt; (gratis): campos, formatos, cruce OCR vs extracción, coherencia orden ↔ HC.&lt;br&gt;&lt;b&gt;2. Modelo pequeño&lt;/b&gt; (GPT-5 nano o equivalente) solo con el resultado + fragmentos de evidencia, nunca el documento completo; la rúbrica fija se cachea.&lt;br&gt;&lt;b&gt;3. Escala&lt;/b&gt; a un modelo mayor solo si duda (≈ 5–10 % de los casos).&lt;br&gt;&lt;b&gt;Rúbrica propia&lt;/b&gt; por microservicio y por escenario (tipo de solicitud), versionada y configurable · costo ≈ US$ 0,0001 por solicitud." vertex="1">
          <mxGeometry height="230" width="850" x="1290" y="1590.0" as="geometry" />
        </mxCell>
        <mxCell id="zaHUmAEQrHUE2_hIX2zZ-2" parent="1" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#fde9cc;strokeColor=#d79b00;strokeWidth=3;fontColor=#1a1a1a;fontSize=14;fontFamily=Helvetica;align=left;image=https://icons.diagrams.net/assets/material-symbols/1/Patient_List.svg;imageWidth=44;imageHeight=44;spacingLeft=64;" value="&lt;b&gt;Canales&lt;/b&gt;" vertex="1">
