        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-49" edge="1" parent="Dlz2w1c-RvbU9iQR3jtd-10" source="Dlz2w1c-RvbU9iQR3jtd-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0288d1;strokeWidth=2;dashed=0;fontColor=#0277bd;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;" target="Dlz2w1c-RvbU9iQR3jtd-31" value="⑤b duplicada · JSON/HTTP">
          <mxGeometry relative="1" x="-0.7564" as="geometry">
            <mxPoint x="1858.9999999999973" y="598" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-50" edge="1" parent="Dlz2w1c-RvbU9iQR3jtd-1" source="Dlz2w1c-RvbU9iQR3jtd-25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=0;fontColor=#9a6500;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;fontFamily=Helvetica;" target="Dlz2w1c-RvbU9iQR3jtd-4" value="integración">
          <mxGeometry relative="1" x="-0.4265" as="geometry">
            <mxPoint x="278.67" y="344" as="sourcePoint" />
            <mxPoint x="199.48000000000002" y="168.01999999999953" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-51" parent="Dlz2w1c-RvbU9iQR3jtd-1" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;fontFamily=Helvetica;" value='&lt;table border="1" cellpadding="4" style="border-collapse:collapse;width:100%;font-size:12px"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th style="background:#dae8fc"&gt;Entrada / salida&lt;/th&gt;&lt;th style="background:#dae8fc"&gt;Por dónde&lt;/th&gt;&lt;th style="background:#dae8fc"&gt;Qué viaja&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;④ Entrada: el orquestador de integración lo activa&lt;/td&gt;&lt;td&gt;mensaje en la cola RabbitMQ del gestor (orquestador de integración → topic de gestor de evaluación → cola q.evaluacion)&lt;/td&gt;&lt;td&gt;id solicitud + datos extraídos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Paso 1: contexto del caso&lt;/td&gt;&lt;td&gt;API del Core vía MCP (una sola llamada)&lt;/td&gt;&lt;td&gt;pide: historial relevante, datos del afiliado, plan y cláusulas según el servicio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑤ Salida: recomendación&lt;/td&gt;&lt;td&gt;JSON por HTTP al orquestador de integración (vía Apigee) → topic → colas de Core ADR (response aprobado / rechazado)&lt;/td&gt;&lt;td&gt;pertinente, evidencia, confianza, nota del juez → el Core aplica reglas duras y decide&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑤b Salida: duplicada&lt;/td&gt;&lt;td&gt;igual que ⑤&lt;/td&gt;&lt;td&gt;solicitud original y regla aplicada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥ Paso a personas&lt;/td&gt;&lt;td&gt;cola q.revision-humana → clasificador → bandeja N3 o N4&lt;/td&gt;&lt;td&gt;motivo estructurado, evidencia, nivel recomendado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;⑥b Salida: decisión humana&lt;/td&gt;&lt;td&gt;API del Core&lt;/td&gt;&lt;td&gt;decisión y motivo de la enfermera o el médico&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;' vertex="1">
          <mxGeometry height="260" width="1180" x="80" y="2291" as="geometry" />
        </mxCell>
        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-52" parent="Dlz2w1c-RvbU9iQR3jtd-1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#d6b656;rounded=1;spacing=10;" value="&lt;b&gt;Tres decisiones de diseño&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Contexto una sola vez&lt;/b&gt;: el paso 1 trae de una vez lo que necesitan duplicados y pertinencia. El agente solo vuelve a llamar al Core si le falta algo puntual.&lt;br&gt;&lt;b&gt;2. Duplicados con código&lt;/b&gt;: las reglas por servicio viven en el catálogo local; aplicarlas no necesita IA.&lt;br&gt;&lt;b&gt;3. Nivel N3 / N4&lt;/b&gt;: el agente de pertinencia deja un &lt;b&gt;motivo estructurado&lt;/b&gt; (documental o clínico). El clasificador decide el nivel con reglas configurables y solo usa un modelo pequeño si el motivo es ambiguo. El nivel es una &lt;b&gt;recomendación&lt;/b&gt;: el Core puede reasignarlo." vertex="1">
          <mxGeometry height="260" width="850" x="1290" y="2291" as="geometry" />
        </mxCell>
        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-53" edge="1" parent="Dlz2w1c-RvbU9iQR3jtd-1" source="Dlz2w1c-RvbU9iQR3jtd-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#333333;fontFamily=Helvetica;" target="Dlz2w1c-RvbU9iQR3jtd-3">
