rent="vg-l5" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#f7f7f7;strokeColor=#333333;rounded=1;spacing=6;" value='&lt;b&gt;Core Salud Voluntarios&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;inicialmente GlobalWeb · crea el radicado de la solicitud&lt;/font&gt;' vertex="1"><mxGeometry x="800" y="45" width="520" height="80" as="geometry" /></mxCell><mxCell id="vg-konecta" parent="vg-l5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9cc;strokeColor=#d79b00;strokeWidth=3;fontColor=#1a1a1a;fontSize=13;fontFamily=Helvetica;" value='&lt;b&gt;Konecta&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;operación humana · bandeja de revisión&lt;/font&gt;' vertex="1"><mxGeometry x="1350" y="45" width="330" height="80" as="geometry" /></mxCell><mxCell id="vg-l5-tc" parent="vg-l5" style="rounded=1;arcSize=50;html=1;fillColor=#fdf0db;strokeColor=#e08a1e;fontColor=#b35c00;fontSize=10;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" value="→ Torre de control" vertex="1"><mxGeometry x="2190" y="8" width="125" height="18" as="geometry" /></mxCell><mxCell id="vg-l6" parent="1" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#8e5cc4;strokeWidth=2;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Helvetica;" value="6. TORRE DE CONTROL (transversal)" vertex="1"><mxGeometry x="80" y="1650" width="2330" height="300" as="geometry" /></mxCell><mxCell id="vg-t-k" parent="vg-l6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0db;strokeColor=#e08a1e;strokeWidth=2;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;" value='&lt;b&gt;Kafka interno de la Torre de control&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;recibe la trazabilidad de todos: canales · Siniestro integral · orquestador de integración · gestores · cores&lt;/font&gt;' vertex="1"><mxGeometry x="70" y="40" width="1400" height="60" as="geometry" /></mxCell><mxCell id="vg-t-v" parent="vg-l6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4edfa;strokeColor=#8e5cc4;strokeWidth=2;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;" value='&lt;b&gt;Ve el flujo end to end&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;arma el recorrido de cada solicitud&lt;/font&gt;' vertex="1"><mxGeometry x="70" y="120" width="440" height="60" as="geometry" /></mxCell><mxCell id="vg-t-t" parent="vg-l6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4edfa;strokeColor=#8e5cc4;strokeWidth=2;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;" value='&lt;b&gt;Tablero + copiloto&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;estado, tiempos, cuellos de botella, costo&lt;/font&gt;' vertex="1"><mxGeometry x="550" y="120" width="440" height="60" as="geometry" /></mxCell><mxCell id="vg-t-a" parent="vg-l6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeaea;strokeColor=#d9534f;strokeWidth=2;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;" value='&lt;b&gt;Pide acciones al core&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;reasignar, priorizar, reintentar o reactivar un gestor&lt;/font&gt;' vertex="1"><mxGeometry x="1030" y="120" width="440" height="60" as="geometry" /></mxCell><mxCell id="vg-t-e1" edge="1" parent="vg-l6" source="vg-t-k" target="vg-t-v" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7a8496;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7a8496;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vg-t-e2" edge="1" parent="vg-l6" source="vg-t-v" target="vg-t-t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7a8496;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7a8496;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vg-t-e3" edge="1" parent="vg-l6" source="vg-t-t" target="vg-t-a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7a8496;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7a8496;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vg-l7" parent="1" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#888888;strokeWidth=2;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Helvetica;" value="7. CÓMO SE LEE" vertex="1"><mxGeometry x="80" y="1980" width="2330" height="260" as="geometry" /></mxCell><mxCell id="vg-x1" edge="1" parent="1" source="vg-portal" target="vg-apigee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value="radica"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vg-x2" edge="1" parent="1" source="vg-apigee" target="vg-si-orq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value="HTTP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="295" /><mxPoint x="237" y="295" /></Array></mxGeometry></mxCell><mxCell id="vg-x3" edge="1" parent="1" source="vg-si-enc" target="vg-o-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#d79b00;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value="comando · HTTP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="758" y="505" /><mxPoint x="242" y="505" /></Array></mxGeometry></mxCell><mxCell id="vg-x4" edge="1" parent="1" source="vg-o-6" target="vg-g0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#d79b00;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value="① mensaje en cola"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1252" y="805" /><mxPoint x="360" y="805" /></Array></mxGeometry></mxCell><mxCell id="vg-x5" edge="1" parent="1" source="vg-o-6" target="vg-g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#d79b00;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1252" y="805" /><mxPoint x="805" y="805" /></Array></mxGeometry></mxCell><mxCell id="vg-x6" edge="1" parent="1" source="vg-o-6" target="vg-si-res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#43a047;strokeWidth=2;endArrow=block;endFill=1;fontColor=#43a047;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value="resultado"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1252" y="505" /><mxPoint x="1038" y="505" /></Array></mxGeometry></mxCell><mxCell id="vg-x7" edge="1" parent="1" source="vg-c-note" target="vg-si-est" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#d79b00;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" value="consulta el estado y notifica"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="247" /><mxPoint x="1238" y="247" /></Array></mxGeometry></mxCell><mxCell id="c74" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Auditoría de cada gestor&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Torre de Control&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;¿Qué es?&lt;/td&gt;&lt;td&gt;Registro propio de un microservicio&lt;/td&gt;&lt;td&gt;Componente transversal de toda la operación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;¿Qué guarda?&lt;/td&gt;&lt;td&gt;Qué hizo cada agente, qué decidió y con qué evidencia&lt;/td&gt;&lt;td&gt;El recorrido completo de cada autorización&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;¿Puede actuar?&lt;/td&gt;&lt;td&gt;No: solo registra y se consulta&lt;/td&gt;&lt;td&gt;Sí: pide acciones al Core&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="200" width="1000" x="160" y="2020" as="geometry" />
        </mxCell>
        <mxCell id="c75" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#0288d1;rounded=1;spacing=10;" value="&lt;b&gt;Contrato igual para todos los gestores&lt;/b&gt;&lt;br&gt;1. El &lt;b&gt;orquestador de integración&lt;/b&gt; lo &lt;b&gt;activa&lt;/b&gt; con un mensaje en su cola RabbitMQ.&lt;br&gt;2. El gestor &lt;b&gt;trabaja&lt;/b&gt; según su configuración.&lt;br&gt;3. &lt;b&gt;Devuelve&lt;/b&gt; el resultado como JSON por HTTP al orquestador de integración, que lo encola hacia quien lo consume.&lt;br&gt;4. Guarda su &lt;b&gt;auditoría&lt;/b&gt; y envía su &lt;b&gt;trazabilidad&lt;/b&gt; a la Torre de control (Kafka interno).&lt;br&gt;&lt;br&gt;&lt;b&gt;Dónde corre&lt;/b&gt;: cada gestor es una app en &lt;b&gt;AKS&lt;/b&gt; (red privada), que escala según los mensajes de su cola." vertex="1">
          <mxGeometry height="210" width="870" x="1250" y="2020" as="geometry" />
        </mxCell>
      </root></mxGraphModel></diagram>
