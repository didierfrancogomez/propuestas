        <mxCell id="zaHUmAEQrHUE2_hIX2zZ-52" parent="zaHUmAEQrHUE2_hIX2zZ-44" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=none;image=https://app.diagrams.net/img/lib/azure2/integration/AI_Gateway.svg;" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;modelo por decidir:&lt;br&gt;Azure OpenAI o Gemini&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C3&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="48" x="115" y="68" as="geometry" />
