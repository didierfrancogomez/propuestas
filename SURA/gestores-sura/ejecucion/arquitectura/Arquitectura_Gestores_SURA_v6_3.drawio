        <mxCell id="4C8p2419GL-tcQHq8wRN-76" edge="1" parent="4C8p2419GL-tcQHq8wRN-1" source="4C8p2419GL-tcQHq8wRN-47" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=0;fontColor=#9a6500;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.908;entryY=0.919;entryDx=0;entryDy=0;fontFamily=Helvetica;entryPerimeter=0;" target="4C8p2419GL-tcQHq8wRN-90" value="③b requiere revisión">
          <mxGeometry relative="1" x="-0.0002" as="geometry">
