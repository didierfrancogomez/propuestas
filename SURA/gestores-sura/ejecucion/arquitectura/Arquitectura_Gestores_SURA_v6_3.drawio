        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-50" edge="1" parent="Dlz2w1c-RvbU9iQR3jtd-1" source="Dlz2w1c-RvbU9iQR3jtd-25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=0;fontColor=#9a6500;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;fontFamily=Helvetica;" target="Dlz2w1c-RvbU9iQR3jtd-4" value="integración">
          <mxGeometry relative="1" x="-0.4265" as="geometry">
