        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-44" parent="Dlz2w1c-RvbU9iQR3jtd-10" style="whiteSpace=wrap;html=1;strokeColor=#d6b656;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1a1a1a;fillColor=#fff7d6;" value="&lt;b style=&quot;white-space: nowrap;&quot;&gt;1. Contexto del caso&lt;/b&gt;&lt;br style=&quot;white-space: nowrap;&quot;&gt;&lt;font style=&quot;white-space: nowrap; font-size: 11px;&quot;&gt;una sola consulta al Core&lt;br&gt;(detalle abajo)&lt;/font&gt;&lt;br style=&quot;white-space: nowrap;&quot;&gt;&lt;font style=&quot;white-space: nowrap; font-size: 10px;&quot;&gt;C5 · servicio&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;white-space: nowrap; font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;white-space: nowrap; font-size: 10px;&quot;&gt;&lt;font style=&quot;text-align: left; font-size: 11px;&quot;&gt;protocolos, políticas y cláusulas&lt;br&gt;filtrados por el plan del afiliado&lt;/font&gt;&lt;br style=&quot;font-size: 13px; text-align: left;&quot;&gt;&lt;font style=&quot;text-align: left;&quot;&gt;C6 · RAG&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
