        <mxCell id="c48" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=11;fontFamily=Georgia;align=left;verticalAlign=top;" value="&lt;font color=&quot;#0277bd&quot;&gt;← lo usa el Gestor Solicitud (hoja Detalle: Gestor Solicitud, parte B)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="520" x="300" y="1378" as="geometry" />
        </mxCell>
        <mxCell id="c49" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Georgia;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#d6b656;rounded=1;spacing=10;" value="Equivalente en GCP: Document AI OCR (precio similar). &lt;b&gt;Recomendación&lt;/b&gt;: leer siempre en Azure, aunque el modelo sea Gemini. Así el documento completo no sale del perímetro y al modelo solo se envían las páginas y secciones necesarias." vertex="1">
          <mxGeometry height="110" width="1300" x="820" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c50" parent="1" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#8e5cc4;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" value="6. CALIDAD Y COSTO" vertex="1">
          <mxGeometry height="190" width="2060" x="80" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="c51" parent="1" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://app.diagrams.net/img/lib/azure2/devops/Application_Insights.svg;" value="&lt;b&gt;App Insights&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tokens, tiempo y saturación por gestor&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C7&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="52" x="234" y="1484" as="geometry" />
        </mxCell>
        <mxCell id="c52" parent="1" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://app.diagrams.net/img/lib/azure2/ai_machine_learning/AI_Foundry.svg;" value="&lt;b&gt;Foundry Evaluations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;prueba cada prompt antes de publicarlo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C7&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="52" x="614" y="1484" as="geometry" />
        </mxCell>
        <mxCell id="c53" parent="1" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://app.diagrams.net/img/lib/azure2/power_platform/PowerBI.svg;" value="&lt;b&gt;Torre de Control&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;costo por solicitud&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C1&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="52" x="994" y="1484" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=11;fontFamily=Georgia;align=left;verticalAlign=top;" value="&lt;font color=&quot;#6a3d9a&quot;&gt;↑ reciben datos de todos los gestores y del gateway&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="700" x="180" y="1595" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Georgia;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#8e5cc4;rounded=1;spacing=10;" value="&lt;b&gt;¿Cómo se decide entre Opción 1 y 2?&lt;/b&gt; Prueba con 300–500 documentos reales de P8: aciertos por campo crítico (cédula, CUPS, cantidad, vigencia, médico), costo y tiempo. Como todo pasa por el gateway, cambiar de modelo después es solo configuración." vertex="1">
          <mxGeometry height="140" width="860" x="1260" y="1465" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d5" name="Duplicados por servicio">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1700" math="0" shadow="0" background="#ffffff" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;Duplicados por servicio — cómo consultamos al Core&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Idea clave: separar la &lt;b&gt;REGLA&lt;/b&gt; (pocas, cambian poco → copia local) del &lt;b&gt;HISTORIAL del paciente&lt;/b&gt; (enorme, cambia siempre → se pregunta al Core solo lo necesario)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=20;fontFamily=Georgia;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="10" width="2050" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="1. EL PROBLEMA" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#888888;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="2060" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Servicio (ejemplo)&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Regla de duplicidad&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Ventana&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Qué se compara&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Consulta medicina general&lt;/td&gt;&lt;td&gt;puede repetirse; máx. 2 por mes&lt;/td&gt;&lt;td&gt;30 días&lt;/td&gt;&lt;td&gt;paciente + CUPS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Resonancia magnética&lt;/td&gt;&lt;td&gt;no repetir la misma zona&lt;/td&gt;&lt;td&gt;6 meses&lt;/td&gt;&lt;td&gt;paciente + CUPS + zona&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Nefrectomía (riñón)&lt;/td&gt;&lt;td&gt;una sola vez por lado&lt;/td&gt;&lt;td&gt;toda la vida&lt;/td&gt;&lt;td&gt;paciente + CUPS + lateralidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Terapia física&lt;/td&gt;&lt;td&gt;máx. 20 sesiones al año&lt;/td&gt;&lt;td&gt;12 meses&lt;/td&gt;&lt;td&gt;paciente + grupo de CUPS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="180" y="100" width="1200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;font color=&quot;#555555&quot;&gt;Cada servicio tiene su propia regla. Las reglas las define SURA y viven en el Core; nosotros las aplicamos. &lt;i&gt;(Ejemplos ilustrativos.)&lt;/i&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1420" y="120" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="2. LAS REGLAS: copia local sincronizada" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#d79b00;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="2060" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Core SURA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;dueño de las reglas&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C5&lt;/font&gt;" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/material-symbols/1/Patient_List.svg;" vertex="1" parent="1">
          <mxGeometry x="194" y="414" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Cuando cambia una regla&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;el Core publica en Kafka (reglas.duplicidad.actualizada) o deja una exportación diaria&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0db;strokeColor=#e08a1e;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="400" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Sincronizador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;servicio pequeño que actualiza la copia&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C4 · Workflow&lt;/font&gt;" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://app.diagrams.net/img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1">
          <mxGeometry x="874" y="414" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Catálogo de reglas de duplicidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MongoDB · versionado · por CUPS / grupo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C6&lt;/font&gt;" style="image;aspect=fixed;html=1;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1124" y="414" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;font color=&quot;#555555&quot;&gt;Aunque sean miles de reglas, son &lt;b&gt;datos pequeños y estables&lt;/b&gt;: se consultan en milisegundos, sin depender de la red ni de que el Core esté disponible.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1500" y="400" width="620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="3. EN CADA SOLICITUD (dentro del Gestor Evaluación)" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#0288d1;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="2060" height="260" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;a. ¿Qué regla aplica?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;busca la regla del CUPS en el catálogo local&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fa;strokeColor=#0288d1;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="660" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;b. Una sola llamada al Core&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;historial de esos CUPS desde la fecha + datos del afiliado y cláusulas (los reutiliza la pertinencia)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fa;strokeColor=#0288d1;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="570" y="660" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;MCP Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;API de historial del Core&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C3&lt;/font&gt;" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://app.diagrams.net/img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1">
          <mxGeometry x="1076" y="676" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Core SURA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;responde sí / no + ids&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#0277bd&quot;&gt;C5&lt;/font&gt;" style="image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/material-symbols/1/Patient_List.svg;" vertex="1" parent="1">
          <mxGeometry x="1316" y="676" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;c. ¿Duplicada?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;aplica la regla con la respuesta y deja la evidencia en la auditoría&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fa;strokeColor=#0288d1;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1540" y="660" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7a8496;strokeWidth=2;dashed=0;fontColor=#4f5868;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;font color=&quot;#555555&quot;&gt;Solo viaja lo necesario para este caso. La respuesta queda en el expediente del caso y se reutiliza en la pertinencia, sin volver a llamar al Core.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Georgia;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="180" y="790" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="4. POR QUÉ ASÍ" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#888888;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="80" y="860" width="2060" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Opción&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;A favor&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;En contra&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Veredicto&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;El Core envía todas las reglas con cada solicitud&lt;/td&gt;&lt;td&gt;simple de entender&lt;/td&gt;&lt;td&gt;mensajes enormes; casi todas las reglas no aplican al caso&lt;/td&gt;&lt;td&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Copiar el historial de pacientes a nuestro lado&lt;/td&gt;&lt;td&gt;consultas rápidas&lt;/td&gt;&lt;td&gt;datos de salud duplicados, se desactualiza, sincronización costosa&lt;/td&gt;&lt;td&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Preguntar todo al Core por API en cada caso&lt;/td&gt;&lt;td&gt;siempre actualizado&lt;/td&gt;&lt;td&gt;cada solicitud depende de varias llamadas; más lento&lt;/td&gt;&lt;td&gt;parcial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Reglas en copia local + historial por consulta puntual&lt;/b&gt;&lt;/td&gt;&lt;td&gt;rápido, actualizado, mínimos datos de salud fuera del Core&lt;/td&gt;&lt;td&gt;requiere una API de historial en el Core&lt;/td&gt;&lt;td&gt;&lt;b&gt;✔ recomendado&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="180" y="890" width="1300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;Si el Core aún no tiene API de historial&lt;/b&gt;&lt;br&gt;Plan B: al activar el Gestor Evaluación, el Core incluye en el mensaje el historial relevante del paciente (por ejemplo, últimos 12 meses y procedimientos “de una sola vez”). Cuando exista la API, se cambia sin tocar el resto." style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=13;fontFamily=Georgia;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#d6b656;rounded=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1510" y="890" width="610" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="Glosario: qué es cada cosa">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;¿Qué es cada cosa? — Nombre en la Arquitectura de Referencia → qué usamos → para qué sirve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Para leer el diagrama sin ser técnico&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Capa&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Nombre en la referencia&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Qué usamos en esta solución&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;¿Para qué sirve? (en simple)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C1&lt;/td&gt;&lt;td&gt;Consumidores y superficies&lt;/td&gt;&lt;td&gt;Portal proveedor (ADR), app cliente, asesor, oficina, bandejas N3/N4, Torre de control&lt;/td&gt;&lt;td&gt;Las pantallas por donde la gente pide, revisa o decide. No tienen IA adentro.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C2&lt;/td&gt;&lt;td&gt;Identidad, acceso y contexto&lt;/td&gt;&lt;td&gt;Entra ID, Managed Identities, Key Vault&lt;/td&gt;&lt;td&gt;Saber quién es cada persona o sistema y qué le está permitido hacer.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C3&lt;/td&gt;&lt;td&gt;API Gateway&lt;/td&gt;&lt;td&gt;Azure API Management&lt;/td&gt;&lt;td&gt;La puerta de entrada única para las solicitudes de los canales.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C3&lt;/td&gt;&lt;td&gt;LLM Gateway&lt;/td&gt;&lt;td&gt;API Management (AI Gateway)&lt;/td&gt;&lt;td&gt;El “peaje” obligatorio para hablar con un modelo de IA: controla cuánto se gasta y quién lo usa.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C3&lt;/td&gt;&lt;td&gt;MCP Gateway&lt;/td&gt;&lt;td&gt;API Management (MCP)&lt;/td&gt;&lt;td&gt;Controla qué sistemas de SURA puede consultar cada agente.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C3&lt;/td&gt;&lt;td&gt;A2A Gateway&lt;/td&gt;&lt;td&gt;API Management (futuro)&lt;/td&gt;&lt;td&gt;Para que agentes de otros casos de uso hablen con los nuestros de forma controlada.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AIS&lt;/td&gt;&lt;td&gt;AI Security&lt;/td&gt;&lt;td&gt;Defender for Storage, Content Safety, Purview, validación de archivos&lt;/td&gt;&lt;td&gt;Revisa que los archivos y textos sean seguros: virus, trucos para engañar a la IA, datos sensibles.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Workflow Runtime&lt;/td&gt;&lt;td&gt;Container Apps / Functions&lt;/td&gt;&lt;td&gt;Ejecuta pasos fijos que siempre son iguales (separar páginas, reglas duras).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Agent Runtime / Orchestrator&lt;/td&gt;&lt;td&gt;LangChain + LangGraph en Container Apps&lt;/td&gt;&lt;td&gt;Donde viven los gestores que razonan y deciden según el caso.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Processing Strategy&lt;/td&gt;&lt;td&gt;Híbrida&lt;/td&gt;&lt;td&gt;Primero se extrae el texto y luego el modelo mira texto + imagen original.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Document Processor&lt;/td&gt;&lt;td&gt;Azure AI Document Intelligence&lt;/td&gt;&lt;td&gt;Lee el PDF o la foto y dice qué tan seguro está de lo que leyó.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Multimodal Models&lt;/td&gt;&lt;td&gt;GPT-5 mini y modelo razonador (Foundry); Gemini opcional&lt;/td&gt;&lt;td&gt;La IA que entiende documentos y razona sobre pertinencia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;State / session&lt;/td&gt;&lt;td&gt;MongoDB (checkpoints)&lt;/td&gt;&lt;td&gt;Recordar en qué paso va cada solicitud, aunque se reinicie el sistema.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C5&lt;/td&gt;&lt;td&gt;Domain APIs / MCP Tools&lt;/td&gt;&lt;td&gt;SuraHist, reglas duras N1, Global Web, coberturas, prestadores, API docs P8, Tibot&lt;/td&gt;&lt;td&gt;Los sistemas de SURA que el agente consulta o donde escribe el resultado.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C5&lt;/td&gt;&lt;td&gt;Events&lt;/td&gt;&lt;td&gt;RabbitMQ (colas) y Kafka (eventos)&lt;/td&gt;&lt;td&gt;RabbitMQ entrega trabajo a cada gestor (lo urgente primero). Kafka avisa lo que ya pasó a quien le interese, como la Torre de Control.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Gestor (módulo)&lt;/td&gt;&lt;td&gt;API + cola + agentes + auditoría propia&lt;/td&gt;&lt;td&gt;Pieza independiente: se puede usar sola, encadenada o retomar un caso manual.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Coordinador y perfil de proceso&lt;/td&gt;&lt;td&gt;Servicio + configuración en MongoDB&lt;/td&gt;&lt;td&gt;Decide qué gestor sigue según el tipo de solicitud, sin que los gestores se conozcan entre sí.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C7&lt;/td&gt;&lt;td&gt;Auditoría del gestor&lt;/td&gt;&lt;td&gt;MongoDB propio de cada gestor&lt;/td&gt;&lt;td&gt;Registro detallado de lo que hizo cada gestor y sus agentes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C5&lt;/td&gt;&lt;td&gt;Core SURA (SuraHist)&lt;/td&gt;&lt;td&gt;Sistema core de SURA&lt;/td&gt;&lt;td&gt;Dirige el proceso: decide qué gestor activar y cuándo, y recibe sus resultados.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Microservicio gestor&lt;/td&gt;&lt;td&gt;Una app por gestor en Azure Container Apps&lt;/td&gt;&lt;td&gt;Pieza independiente que el Core activa por su API; no habla con otros gestores.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C7&lt;/td&gt;&lt;td&gt;Juez del microservicio&lt;/td&gt;&lt;td&gt;Chequeos con código + modelo pequeño (GPT-5 nano o equivalente)&lt;/td&gt;&lt;td&gt;Revisa que cada microservicio hizo bien su trabajo; tiene rúbrica propia por escenario y cuesta centavos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C6&lt;/td&gt;&lt;td&gt;Catálogo de reglas de duplicidad&lt;/td&gt;&lt;td&gt;Copia local en MongoDB, sincronizada desde el Core&lt;/td&gt;&lt;td&gt;Dice qué cuenta como duplicado para cada servicio; el historial del paciente se consulta al Core.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C1&lt;/td&gt;&lt;td&gt;Torre de Control&lt;/td&gt;&lt;td&gt;Componente transversal + tablero + copiloto&lt;/td&gt;&lt;td&gt;Ve el flujo completo con los eventos de Kafka y puede actuar: reasignar, priorizar, reintentar, pausar, reingresar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C4&lt;/td&gt;&lt;td&gt;Configuración de entrada&lt;/td&gt;&lt;td&gt;Catálogo por tipo de solicitud y consumidor&lt;/td&gt;&lt;td&gt;Define qué documentos buscar (salud: HC + orden) sin cambiar código.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C6&lt;/td&gt;&lt;td&gt;Vector / hybrid search&lt;/td&gt;&lt;td&gt;Azure AI Search&lt;/td&gt;&lt;td&gt;Buscador de protocolos, políticas y CUPS para justificar decisiones.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C6&lt;/td&gt;&lt;td&gt;Object storage&lt;/td&gt;&lt;td&gt;Blob Storage / ADLS Gen2&lt;/td&gt;&lt;td&gt;Guarda los documentos originales y las páginas separadas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C6&lt;/td&gt;&lt;td&gt;Knowledge Pipeline&lt;/td&gt;&lt;td&gt;Functions (asíncrono)&lt;/td&gt;&lt;td&gt;Mantiene actualizado el buscador cuando cambian las políticas; no frena la respuesta.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C7&lt;/td&gt;&lt;td&gt;Tracing / métricas&lt;/td&gt;&lt;td&gt;App Insights + Azure Monitor + Dynatrace&lt;/td&gt;&lt;td&gt;Ver qué pasó con cada solicitud, cuánto tardó y cuánto costó.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C7&lt;/td&gt;&lt;td&gt;Evals&lt;/td&gt;&lt;td&gt;Foundry Evaluations + LLM juez&lt;/td&gt;&lt;td&gt;Medir si la IA está acertando y avisar si empeora.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C8&lt;/td&gt;&lt;td&gt;Gobierno, riesgo y cumplimiento&lt;/td&gt;&lt;td&gt;Políticas, aprobaciones, retención, Azure Policy&lt;/td&gt;&lt;td&gt;Las reglas: qué se permite, cuánto se guarda la HC, quién aprueba cambios.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1840" height="900" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="jg-JWJ0tb6M7J7A5PJX5" name="estructuras de mensajes de trazaibilidad">
    <mxGraphModel dx="2934" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
      </root>
    </mxGraphModel>
  </diagram>
