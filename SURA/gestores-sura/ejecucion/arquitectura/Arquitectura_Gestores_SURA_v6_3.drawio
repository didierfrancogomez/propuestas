        <mxCell id="c73" parent="1" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#888888;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" value="6. CÓMO SE LEE" vertex="1">
          <mxGeometry height="260" width="2060" x="80" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c74" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#1a1a1a;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Auditoría de cada gestor&lt;/th&gt;&lt;th style=&quot;background:#dae8fc&quot;&gt;Torre de Control&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;¿Qué es?&lt;/td&gt;&lt;td&gt;Registro propio de un microservicio&lt;/td&gt;&lt;td&gt;Componente transversal de toda la operación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;¿Qué guarda?&lt;/td&gt;&lt;td&gt;Qué hizo cada agente, qué decidió y con qué evidencia&lt;/td&gt;&lt;td&gt;El recorrido completo de cada autorización&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;¿Puede actuar?&lt;/td&gt;&lt;td&gt;No: solo registra y se consulta&lt;/td&gt;&lt;td&gt;Sí: pide acciones al Core&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="200" width="1000" x="180" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="c75" parent="1" style="text;html=1;whiteSpace=wrap;fontColor=#1a1a1a;fontSize=12;fontFamily=Georgia;align=left;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#0288d1;rounded=1;spacing=10;" value="&lt;b&gt;Contrato igual para todos los gestores&lt;/b&gt;&lt;br&gt;1. El Core lo &lt;b&gt;activa&lt;/b&gt; por su API (el mensaje queda en su cola RabbitMQ).&lt;br&gt;2. El gestor &lt;b&gt;trabaja&lt;/b&gt; según su configuración.&lt;br&gt;3. &lt;b&gt;Devuelve&lt;/b&gt; el resultado al Core.&lt;br&gt;4. Guarda su &lt;b&gt;auditoría&lt;/b&gt; y publica su &lt;b&gt;evento&lt;/b&gt; en Kafka.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dónde corre&lt;/b&gt;: cada gestor es una app en &lt;b&gt;Azure Container Apps&lt;/b&gt; (plan dedicado, red privada), que escala según los mensajes de su cola." vertex="1">
          <mxGeometry height="210" width="870" x="1210" y="1255" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
