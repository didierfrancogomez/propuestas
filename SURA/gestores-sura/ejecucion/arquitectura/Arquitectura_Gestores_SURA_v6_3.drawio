        <mxCell id="4C8p2419GL-tcQHq8wRN-75" edge="1" parent="4C8p2419GL-tcQHq8wRN-1" source="4C8p2419GL-tcQHq8wRN-46" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#43a047;strokeWidth=2;dashed=0;fontColor=#2e7d32;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;fontFamily=Helvetica;entryX=0.869;entryY=0.513;entryDx=0;entryDy=0;entryPerimeter=0;" target="4C8p2419GL-tcQHq8wRN-90" value="③ resultado">
