        <mxCell id="Dlz2w1c-RvbU9iQR3jtd-49" edge="1" parent="Dlz2w1c-RvbU9iQR3jtd-10" source="Dlz2w1c-RvbU9iQR3jtd-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0288d1;strokeWidth=2;dashed=0;fontColor=#0277bd;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;" target="Dlz2w1c-RvbU9iQR3jtd-31" value="⑤b duplicada">
