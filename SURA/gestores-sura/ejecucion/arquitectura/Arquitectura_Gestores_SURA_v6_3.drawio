        <mxCell id="c39" value="3. QUÉ TIENE UNA RÚBRICA (ejemplos)" style="swimlane;horizontal=0;startSize=46;html=1;fillColor=#f7f7f7;swimlaneFillColor=#fcfcfc;strokeColor=#8e5cc4;fontColor=#1a1a1a;fontStyle=1;fontSize=14;fontFamily=Georgia;" vertex="1" parent="1">
