          <mxGeometry height="533" width="800" x="1780" y="540" as="geometry" />
        </mxCell>
        <mxCell id="NUcRKiA5lQnUvOEFi1UQ-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;labelBackgroundColor=default;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;b&gt;1. Estado actual de entradas por etapas de proceso (real time)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;strong&gt;Objetivo:&lt;/strong&gt;&amp;nbsp;capturar, consolidar y visualizar las entradas desde las diferentes etapas de procesos.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Responsabilidades:&lt;/strong&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;ul&gt;&lt;li&gt;Recepción de eventos desde diferentes canales, cores y capacidades agenticas.&lt;/li&gt;&lt;li&gt;Consolidación del volumen de entradas por etapas de proceso (preradicación, solicitud, evaluación, coordinación, prestación y finalización)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="410" width="840" x="80" y="390" as="geometry" />
        </mxCell>
        <mxCell id="NUcRKiA5lQnUvOEFi1UQ-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;Torre de Control&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;span data-teams=&quot;true&quot;&gt;&lt;ul&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;li&gt;&lt;span data-teams=&quot;true&quot;&gt;Trazabilidad end-to-end.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span data-teams=&quot;true&quot;&gt;&lt;span data-teams=&quot;true&quot;&gt;Monitoreo funcional del proceso.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Detectar riesgos.&lt;/li&gt;&lt;li&gt;Identificar eventos pendientes.&lt;/li&gt;&lt;li&gt;Generar alertas.&lt;/li&gt;&lt;li&gt;Activar acompañamiento.&lt;/li&gt;&lt;li&gt;Recomendar acciones.&lt;/li&gt;&lt;li&gt;Anticipar problemas operativos.&lt;/li&gt;&lt;/font&gt;&lt;/ul&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="460" x="350" y="50" as="geometry" />
        </mxCell>
        <mxCell id="NUcRKiA5lQnUvOEFi1UQ-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;b&gt;2. Indicadores de entradas por etapas de proceso&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;strong&gt;Objetivo:&lt;/strong&gt;&amp;nbsp;identificación de anomalias y alertamientos de entradas por etapas de proceso&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(preradicación, solicitud, evaluación, coordinación, prestación y finalización)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Responsabilidades:&lt;/strong&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cantidad de entradas recibidas por etapa de proceso.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Capacidad disponible vs. demanda. de entradas por etapas de proceso desde la manualidad&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Cumplimiento de SLA por proceso&lt;/li&gt;&lt;li&gt;Tiempo promedio de entradas por etapa de proceso&lt;/li&gt;&lt;li&gt;Estado de SLA por etapas de proceso&lt;/li&gt;&lt;li&gt;Distribución por canal de entrada&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
