        <mxCell id="qoOW92RnicuHCByzwgT9-143" parent="qoOW92RnicuHCByzwgT9-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;core · SuraHis&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Sistema de registro: estado autoritativo de la autorización. Gestores conserva sus propios estados, como preradicado.&lt;/font&gt;&lt;/div&gt;" vertex="1">
