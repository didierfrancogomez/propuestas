          <mxGeometry height="55" width="3360" y="-215" as="geometry" />
        </mxCell>
        <mxCell id="qoOW92RnicuHCByzwgT9-5" parent="qoOW92RnicuHCByzwgT9-1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#d5e8d4;verticalAlign=top;align=center;strokeColor=#82b366;strokeWidth=3;fontSize=22;spacingTop=4;" value="&lt;span style=&quot;font-weight: 700;&quot;&gt;Torre de control&lt;/span&gt;" vertex="1">
          <mxGeometry height="345" width="1448" x="956" y="-28" as="geometry" />
        </mxCell>
        <mxCell id="qoOW92RnicuHCByzwgT9-8" parent="qoOW92RnicuHCByzwgT9-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;1 · Ingesta y consolidación&lt;/b&gt;&lt;br&gt;Recibe eventos y cargas. Idempotencia, orden y ventana para datos que llegan tarde." vertex="1">
          <mxGeometry height="115" width="630" x="996" y="78" as="geometry" />
        </mxCell>
        <mxCell id="qoOW92RnicuHCByzwgT9-9" parent="qoOW92RnicuHCByzwgT9-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;2 · Correlación y contexto&lt;/b&gt;&lt;br&gt;Arma la vista del caso con llave única, y lo agrupa bajo su siniestro padre." vertex="1">
          <mxGeometry height="115" width="630" x="1651" y="78" as="geometry" />
        </mxCell>
        <mxCell id="qoOW92RnicuHCByzwgT9-16" parent="qoOW92RnicuHCByzwgT9-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;verticalAlign=middle;" value="&lt;b&gt;C1 · Bus de eventos compartido — la torre suscrita a la totalidad de los eventos&lt;/b&gt;&lt;br&gt;Un evento por cada cambio de estado · llave de correlación del caso y del siniestro padre · esquema publicado y versionado con compatibilidad hacia atrás, y el emisor que no lo cumple queda rechazado y registrado como falla del emisor · ingesta idempotente · ventana para la evidencia que llega semanas después.&lt;br&gt;&lt;i&gt;Retención en dos horizontes: la traza técnica vive lo que dure el diagnóstico de un incidente; el registro que sustenta si una decisión estuvo bien, hasta que llegue la glosa o la reclamación.&lt;/i&gt;" vertex="1">
          <mxGeometry height="145" width="3360" y="400" as="geometry" />
        </mxCell>
        <mxCell id="qoOW92RnicuHCByzwgT9-17" edge="1" parent="qoOW92RnicuHCByzwgT9-1" source="qoOW92RnicuHCByzwgT9-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="qoOW92RnicuHCByzwgT9-5" value="">
