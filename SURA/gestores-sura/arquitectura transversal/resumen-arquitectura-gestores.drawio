        <mxCell id="qoOW92RnicuHCByzwgT9-112" edge="1" parent="qoOW92RnicuHCByzwgT9-1" source="qoOW92RnicuHCByzwgT9-109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="qoOW92RnicuHCByzwgT9-110" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qoOW92RnicuHCByzwgT9-113" parent="qoOW92RnicuHCByzwgT9-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C4 · Los techos que el negocio ya fijó,&lt;/b&gt; y que ningún ascenso supera por buena que sea la métrica:&lt;br&gt;· Ningún agente niega. Ante la posibilidad de un rechazo, escala. Para negar no existe G3 ni G4.&lt;br&gt;· La negación es determinística y trazable, nunca probabilística: se sustenta en la caché de reglas versionadas.&lt;br&gt;· Autorización automática solo para servicios de nivel 1. En niveles 3 y 4 (médicos y especialistas), alto costo o riesgo, el techo es G2." vertex="1">
          <mxGeometry height="155" width="830" x="1707.5" y="1640" as="geometry" />
        </mxCell>
