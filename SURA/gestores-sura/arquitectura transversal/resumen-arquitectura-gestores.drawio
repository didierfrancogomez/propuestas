          <mxGeometry height="450" width="800" x="840" y="2683" as="geometry" />
        </mxCell>
        <mxCell id="n160" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontColor=#333333;" value="&lt;b&gt;C7 · Cierre y desenlace:&lt;/b&gt; resultado, cuenta médica asociada y valor.&lt;br&gt;&lt;br&gt;Es el enlace que le da entrada al reloj tardío, y hoy es la pieza que falta para que el circuito cierre. Sin él, la única evidencia disponible es la del momento de decidir, que es justo la que no distingue una autorización bien emitida de una emitida sin sustento." vertex="1">
          <mxGeometry height="190" width="760" x="860" y="2748" as="geometry" />
        </mxCell>
        <mxCell id="n161" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontColor=#333333;" value="&lt;b&gt;C1 · Un caso cerrado operativamente puede seguir recibiendo evidencia de calidad,&lt;/b&gt; sin reabrir el proceso de negocio. Es la ventana para datos rezagados, y es lo único de esta lista que después obliga a rehacer el modelo de datos." vertex="1">
          <mxGeometry height="160" width="760" x="860" y="2953" as="geometry" />
        </mxCell>
        <mxCell id="n162" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontSize=13;fontColor=#333333;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;C7 · SEÑALES TARDÍAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cuenta médica · glosas con su causal · negaciones revertidas tras una reclamación o una tutela · reprocesos por documentación insuficiente · atenciones que nunca se pudieron correlacionar con su autorización.&lt;br&gt;&lt;br&gt;Entran como fuente de primera clase desde el diseño inicial, no como analítica financiera que llega al final.&lt;br&gt;&lt;br&gt;&lt;i&gt;La torre señala, no acusa: una anomalía es una hipótesis con evidencia, y su destino es una cola de investigación humana con su propio registro. Ninguna consecuencia hacia un prestador o un asegurado se dispara de forma automática.&lt;/i&gt;" vertex="1">
          <mxGeometry height="450" width="760" x="1680" y="2683" as="geometry" />
        </mxCell>
        <mxCell id="n163" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontSize=13;fontColor=#333333;" value="&lt;b&gt;&lt;br&gt;C2 · GOLDEN SET POR GESTOR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Versionado, con dueño explícito, y balanceado entre casos que deben resolverse y casos que deben escalarse. Refrescado periódicamente.&lt;br&gt;&lt;br&gt;Cada caso desmentido por el reloj tardío entra automáticamente al golden set del agente responsable.&lt;br&gt;&lt;br&gt;&lt;b&gt;Es la compuerta de la próxima versión de cada agente:&lt;/b&gt; ninguna versión nueva entra a producción sin medirse contra los casos que las personas ya corrigieron, y cada versión declara contra qué versión del golden set se midió." vertex="1">
          <mxGeometry height="450" width="880" x="2480" y="2683" as="geometry" />
        </mxCell>
        <mxCell id="e165" edge="1" parent="1" source="n159" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#f5f5f5;" target="n162" value="cuenta médica">
