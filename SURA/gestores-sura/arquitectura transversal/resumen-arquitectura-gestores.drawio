  <diagram name="Arquitectura MVP" id="vueshqLHQo-VS3A2IrKH">
    <mxGraphModel dx="6059" dy="2843" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
