        <mxCell id="qoOW92RnicuHCByzwgT9-147" parent="qoOW92RnicuHCByzwgT9-1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/general/Storage_Azure_Files.svg;" value="Storage" vertex="1">
