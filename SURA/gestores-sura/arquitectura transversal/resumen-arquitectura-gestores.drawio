        </mxCell>
        <mxCell id="e133" edge="1" parent="1" source="n125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="n127" value="sin convenio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n134" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C7 · Coordinación resuelta:&lt;/b&gt; prestador asignado, si tenía convenio y si hubo rechazo del prestador. Es lo que habilita medir tiempo hasta agenda y capacidad efectiva de la red." vertex="1">
          <mxGeometry height="130" width="500" x="2420" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="n135" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#B9720A;" value="&lt;i&gt;El rombo queda para las decisiones. Evaluar y Sugerir proveedor son pasos, y se dibujan como tales.&lt;/i&gt;" vertex="1">
          <mxGeometry height="55" width="265" x="2655" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="n136" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C2 · La bandeja retorna.&lt;/b&gt; El ajuste que la persona hace sobre el proveedor sugerido es una etiqueta: vuelve al golden set del coordinador. Hoy el trazo termina en la bandeja." vertex="1">
          <mxGeometry height="130" width="395" x="2945" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="e137" edge="1" parent="1" source="n127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n136" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n138" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C4 · Madurez y grado conviven.&lt;/b&gt; La madurez agéntica que el equipo definió para este gestor —determinístico, asistente explicativo, agente autónomo— dice qué tipo de componente es y cómo se espera que evolucione. El grado dice cuánta decisión tiene entregada hoy, para un tipo de caso concreto. Un componente puede ser agéntico y estar en G2 porque todavía no acumuló evidencia." vertex="1">
          <mxGeometry height="140" width="920" x="2420" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="n139" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C6 · Todo lo que estos modelos invocan queda en la traza&lt;/b&gt; con su agente y su versión, y sus permisos se declaran en el plano de control, no en el gestor." vertex="1">
          <mxGeometry height="120" width="920" x="2420" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="e142" edge="1" parent="1" source="n32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e143" edge="1" parent="1" source="n75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e144" edge="1" parent="1" source="n112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n145" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;verticalAlign=middle;" value="&lt;b&gt;C6 · AI Control Plane — LLM Gateway · Prompt Management · runtime agéntico · inventario de herramientas (MCP)&lt;/b&gt;&lt;br&gt;Donde se declara qué le está permitido a cada agente, con qué versión de prompt y de modelo opera, y qué herramientas puede invocar. Atribución de costo por línea de negocio, gestor, agente y caso. El artefacto que se versiona es la unidad completa: prompt, modelo, herramientas, política de memoria y umbrales.&lt;br&gt;&lt;i&gt;La distinción que hace el trabajo: el plano de control decide qué está permitido; la torre observa qué hizo y con qué resultado. Un cambio de tablero no debería poder alterar el comportamiento de un agente.&lt;br&gt;&lt;br&gt;&lt;/i&gt;&lt;b&gt;Independiente por cada Sistema agéntico (Gestor, agente)&lt;br&gt;Un sistema agentico solo puede cambiar su propio AI Control Plane&lt;/b&gt;&lt;i&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="1760.5" y="2068" as="geometry" />
        </mxCell>
        <mxCell id="e146" edge="1" parent="1" source="Ye16KNky48gVQdELtdUi-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n75" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Supc8moO16T5_E07luG_-1" edge="1" parent="1" source="n149" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="n30">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n149" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;core · SuraHis&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Sistema de registro: estado autoritativo de la autorización. Gestores conserva sus propios estados, como preradicado.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="620" y="2448" as="geometry" />
        </mxCell>
        <mxCell id="n150" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;P8&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Gestor documental&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="620" x="660" y="2448" as="geometry" />
        </mxCell>
        <mxCell id="n151" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/general/Storage_Azure_Files.svg;" value="Storage P8" vertex="1">
          <mxGeometry height="100" width="110" x="1150" y="2483" as="geometry" />
        </mxCell>
        <mxCell id="n152" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;Siniestro Integral&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Documentos de la solicitud&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="620" x="1320" y="2448" as="geometry" />
        </mxCell>
        <mxCell id="n153" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/general/Storage_Azure_Files.svg;" value="Storage" vertex="1">
          <mxGeometry height="100" width="110" x="1810" y="2483" as="geometry" />
        </mxCell>
        <mxCell id="n154" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C6 · Interoperabilidad — vía el core&lt;/b&gt;&lt;br&gt;El dato se pide primero a SuraHis; la conexión directa solo se justifica cuando el core no lo tiene ni lo va a tener, que es el principio de responsabilidad única que el equipo ya fijó.&lt;br&gt;&lt;i&gt;Conviene declarar su alcance real: hoy cerca del 30% de prestadores y solo consulta externa.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="690" x="1980" y="2448" as="geometry" />
        </mxCell>
        <mxCell id="n155" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;EPS&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="650" x="2710" y="2448" as="geometry" />
        </mxCell>
