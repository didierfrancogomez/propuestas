        <mxCell id="n197" value="&lt;b&gt;El plano de control, y dónde queda el dato clínico&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
