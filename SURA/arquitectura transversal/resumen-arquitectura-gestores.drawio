          <mxGeometry x="600" y="1480" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="&lt;b&gt;C2 · Corrección estructurada&lt;/b&gt;&lt;br&gt;Qué campo estaba mal, cuál era el valor correcto y de dónde salía en el documento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
