        <mxCell id="e128" edge="1" parent="1" source="n120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="n122" value="sin convenio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n129" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C7 · Coordinación resuelta:&lt;/b&gt; prestador asignado, si tenía convenio y si hubo rechazo del prestador. Es lo que habilita medir tiempo hasta agenda y capacidad efectiva de la red." vertex="1">
          <mxGeometry height="130" width="500" x="2420" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="n130" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C2 · La bandeja retorna.&lt;/b&gt; El ajuste que la persona hace sobre el proveedor sugerido es una etiqueta: vuelve al golden set del coordinador. Hoy el trazo termina en la bandeja." vertex="1">
          <mxGeometry height="130" width="395" x="2945" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="e131" edge="1" parent="1" source="n122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n130" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n132" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C4 · Madurez y grado conviven.&lt;/b&gt; La madurez agéntica que el equipo definió para este gestor —determinístico, asistente explicativo, agente autónomo— dice qué tipo de componente es y cómo se espera que evolucione. El grado dice cuánta decisión tiene entregada hoy, para un tipo de caso concreto. Un componente puede ser agéntico y estar en G2 porque todavía no acumuló evidencia." vertex="1">
          <mxGeometry height="140" width="920" x="2420" y="1205" as="geometry" />
        </mxCell>
        <mxCell id="n133" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C6 · Todo lo que estos modelos invocan queda en la traza&lt;/b&gt; con su agente y su versión, y sus permisos se declaran en el plano de control, no en el gestor." vertex="1">
          <mxGeometry height="120" width="920" x="2420" y="1365" as="geometry" />
        </mxCell>
        <mxCell id="e134" edge="1" parent="1" source="n30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" target="n72" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e135" edge="1" parent="1" source="n72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" target="n107" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e136" edge="1" parent="1" source="n30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e137" edge="1" parent="1" source="n72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e138" edge="1" parent="1" source="n107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="n12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n139" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;verticalAlign=middle;" value="&lt;b&gt;C6 · AI Control Plane — LLM Gateway · Prompt Management · runtime agéntico · inventario de herramientas (MCP)&lt;/b&gt;&lt;br&gt;Donde se declara qué le está permitido a cada agente, con qué versión de prompt y de modelo opera, y qué herramientas puede invocar. Atribución de costo por línea de negocio, gestor, agente y caso. El artefacto que se versiona es la unidad completa: prompt, modelo, herramientas, política de memoria y umbrales.&lt;br&gt;&lt;i&gt;La distinción que hace el trabajo: el plano de control decide qué está permitido; la torre observa qué hizo y con qué resultado. Un cambio de tablero no debería poder alterar el comportamiento de un agente.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="3360" y="1965" as="geometry" />
        </mxCell>
        <mxCell id="e140" edge="1" parent="1" source="n139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.28;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" target="n30" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e141" edge="1" parent="1" source="n139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.56;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" target="n72" value="">
