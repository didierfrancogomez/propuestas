        <mxCell id="n198" value="¿Quién controla qué le está permitido, y dónde queda el dato clínico?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#5B5A66;" vertex="1" parent="1">
          <mxGeometry x="1750" y="3395" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n199" value="&lt;b&gt;C7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="870" y="3455" width="70" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n200" value="&lt;b&gt;El reloj tardío: de la autorización a la glosa&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="955" y="3455" width="780" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n201" value="¿Esto nos baja la glosa y el fraude, o solo nos acelera?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#5B5A66;" vertex="1" parent="1">
          <mxGeometry x="1750" y="3455" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n202" value="Ninguno de los siete complementos mueve una pieza de lugar ni redistribuye responsabilidades entre gestores. Seis extienden algo que ya está dibujado, y uno solo, el bus de eventos, agrega una pieza que la convención de elementos de la vista ya anticipaba al declarar el generador de evento.&lt;br&gt;El orden que recomendamos: C1 y C2 primero, porque la evidencia que no se captura mientras el gestor se construye no se recupera después. C5 y C6 se resuelven en la vista casi de inmediato. C4 antes del primer agente que decida sin revisión. C3 cuando el golden set tenga volumen. C7 cuando exista el lago de datos." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5B5A66;" vertex="1" parent="1">
          <mxGeometry x="0" y="3540" width="3360" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
