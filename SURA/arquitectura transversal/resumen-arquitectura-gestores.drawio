        <mxCell id="n27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C1 · Marca de origen en el evento&lt;/b&gt;&lt;br&gt;Cada solicitud viaja con su canal, para que los casos que entran por caminos que se saltan gestores no contaminen la métrica de quien no participó." vertex="1">
          <mxGeometry height="115" width="470" x="25" y="1285" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C7 · Confirmación desde el front&lt;/b&gt;&lt;br&gt;El asegurado confirmando la atención es una de las tres fuentes del reloj tardío, y publica su propio nivel de confianza." vertex="1">
          <mxGeometry height="115" width="470" x="25" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C6 · Superficies externas&lt;/b&gt;&lt;br&gt;Los tableros de asegurado y de prestador se tratan como superficies externas: filtrado por perfil antes de construir la vista, y su propio control de acceso." vertex="1">
          <mxGeometry height="130" width="470" x="25" y="1545" as="geometry" />
