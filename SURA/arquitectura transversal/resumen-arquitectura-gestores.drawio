        <mxCell id="n29" value="&lt;b&gt;C1 · Marca de origen en el evento&lt;/b&gt;&lt;br&gt;Cada solicitud viaja con su canal, para que los casos que entran por caminos que se saltan gestores no contaminen la métrica de quien no participó." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="25" y="1285" width="470" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;C7 · Confirmación desde el front&lt;/b&gt;&lt;br&gt;El asegurado confirmando la atención es una de las tres fuentes del reloj tardío, y publica su propio nivel de confianza." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="25" y="1415" width="470" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;C6 · Superficies externas&lt;/b&gt;&lt;br&gt;Los tableros de asegurado y de prestador se tratan como superficies externas: filtrado por perfil antes de construir la vista, y su propio control de acceso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="25" y="1545" width="470" height="130" as="geometry" />
        </mxCell>
