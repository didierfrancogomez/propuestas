          <mxGeometry height="56" width="56" x="1552" y="1432" as="geometry" />
        </mxCell>
        <mxCell id="n102" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C3 · Versión candidata → compuerta → promoción registrada&lt;/b&gt;&lt;br&gt;El mismo camino que en Solicitud, con la misma compuerta." vertex="1">
          <mxGeometry height="110" width="300" x="1685" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="n103" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C3 · Se mide por resultado&lt;/b&gt;&lt;br&gt;Qué proporción de sus recomendaciones aprobadas mejoró la métrica del agente auditado en la medición siguiente." vertex="1">
          <mxGeometry height="110" width="325" x="2000" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="e104" edge="1" parent="1" source="n100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=1;exitY=0.24;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="n102" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e105" edge="1" parent="1" source="n102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="n103" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n106" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C4 · Los techos que el negocio ya fijó,&lt;/b&gt; y que ningún ascenso supera por buena que sea la métrica:&lt;br&gt;· Ningún agente niega. Ante la posibilidad de un rechazo, escala. Para negar no existe G3 ni G4.&lt;br&gt;· La negación es determinística y trazable, nunca probabilística: se sustenta en la caché de reglas versionadas.&lt;br&gt;· Autorización automática solo para servicios de nivel 1. En niveles 3 y 4, alto costo o riesgo, el techo es G2." vertex="1">
          <mxGeometry height="155" width="830" x="1495" y="1640" as="geometry" />
        </mxCell>
