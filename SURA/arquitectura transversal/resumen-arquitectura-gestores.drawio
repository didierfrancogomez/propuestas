        <mxCell id="n118" value="Modelo experto Coordinador (por nombrar)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3000" y="655" width="175" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n119" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.sagemaker_model;" vertex="1" parent="1">
          <mxGeometry x="3059.5" y="657" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.24;exitDx=0;exitDy=0;entryX=0;entryY=0.24;entryDx=0;entryDy=0;" edge="1" parent="1" source="n112" target="n114">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n121" value="&lt;b&gt;Antes de la lámina:&lt;/b&gt; conviene que los tres lleguen con nombre. Un recuadro sin nombre es la primera pregunta del sponsor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3190" y="655" width="160" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n122" value="¿Existe proveedor sugerido?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="2420" y="815" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n123" value="Evaluar proveedor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;arcSize=8;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2655" y="800" width="195" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n124" value="Sugerir proveedor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;arcSize=8;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2655" y="940" width="195" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n125" value="Bandeja&lt;br&gt;(Autorizado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2985" y="795" width="275" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n126" value="Bandeja autorizaciones-convenios&lt;br&gt;(Pendiente coordinar por humano)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2985" y="985" width="275" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e127" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n112" target="n122">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e128" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n122" target="n123">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e129" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n122" target="n124">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e130" value="sugerido · no encuentra proveedor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=blockThin;startFill=1;startSize=8;" edge="1" parent="1" source="n124" target="n123">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e131" value="aprobado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n123" target="n125">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e132" value="sin convenio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n124" target="n126">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n133" value="&lt;b&gt;C7 · Coordinación resuelta:&lt;/b&gt; prestador asignado, si tenía convenio y si hubo rechazo del prestador. Es lo que habilita medir tiempo hasta agenda y capacidad efectiva de la red." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2420" y="1105" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n134" value="&lt;i&gt;El rombo queda para las decisiones. Evaluar y Sugerir proveedor son pasos, y se dibujan como tales.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#B9720A;" vertex="1" parent="1">
          <mxGeometry x="2655" y="1035" width="265" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n135" value="&lt;b&gt;C2 · La bandeja retorna.&lt;/b&gt; El ajuste que la persona hace sobre el proveedor sugerido es una etiqueta: vuelve al golden set del coordinador. Hoy el trazo termina en la bandeja." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2945" y="1105" width="395" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e136" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n126" target="n135">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n137" value="&lt;b&gt;C4 · Madurez y grado conviven.&lt;/b&gt; La madurez agéntica que el equipo definió para este gestor —determinístico, asistente explicativo, agente autónomo— dice qué tipo de componente es y cómo se espera que evolucione. El grado dice cuánta decisión tiene entregada hoy, para un tipo de caso concreto. Un componente puede ser agéntico y estar en G2 porque todavía no acumuló evidencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2420" y="1255" width="920" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n138" value="&lt;b&gt;C6 · Todo lo que estos modelos invocan queda en la traza&lt;/b&gt; con su agente y su versión, y sus permisos se declaran en el plano de control, no en el gestor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2420" y="1415" width="920" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e139" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="n74">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e140" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#666666;dashed=0;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="n74" target="n111">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e141" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="n14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e142" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n74" target="n14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e143" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n111" target="n14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n144" value="&lt;b&gt;C6 · AI Control Plane — LLM Gateway · Prompt Management · runtime agéntico · inventario de herramientas (MCP)&lt;/b&gt;&lt;br&gt;Donde se declara qué le está permitido a cada agente, con qué versión de prompt y de modelo opera, y qué herramientas puede invocar. Atribución de costo por línea de negocio, gestor, agente y caso. El artefacto que se versiona es la unidad completa: prompt, modelo, herramientas, política de memoria y umbrales.&lt;br&gt;&lt;i&gt;La distinción que hace el trabajo: el plano de control decide qué está permitido; la torre observa qué hizo y con qué resultado. Un cambio de tablero no debería poder alterar el comportamiento de un agente.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="1965" width="3360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e145" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.28;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n144" target="n32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e146" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.56;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n144" target="n74">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e147" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=1;exitX=0.86;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n144" target="n111">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n148" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;core · SuraHis&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Sistema de registro: estado autoritativo de la autorización. Gestores conserva sus propios estados, como preradicado.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="0" y="2190" width="620" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n149" value="&lt;font style=&quot;font-size: 17px&quot;&gt;&lt;b&gt;P8&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Gestor documental&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
