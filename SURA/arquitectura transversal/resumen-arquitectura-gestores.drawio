<mxfile host="Electron" agent="Tech and Solve">
  <diagram name="Resumen Arq gestores" id="resumen-arq-gestores-propuesto">
    <mxGraphModel dx="5360" dy="2555" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=32;" value="&lt;b&gt;Resumen Arq gestores&lt;/b&gt;" vertex="1">
          <mxGeometry height="55" width="3360" y="-215" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;" value="Sobre la vista que el equipo viene refinando. En gris y color, el diseño vigente: ninguna pieza cambia de lugar ni de responsabilidad. En &lt;b&gt;ámbar&lt;/b&gt;, los siete complementos que proponemos, C1 a C7. En &lt;b&gt;naranja&lt;/b&gt;, los dos estados que conviene renombrar.&lt;br&gt;Son sugerencias debatibles: cada una se puede tomar, ajustar o descartar sin que se caigan las demás. · Tech and Solve para SURA, septiembre de 2026." vertex="1">
          <mxGeometry height="105" width="3360" y="-155" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#d5e8d4;verticalAlign=top;align=center;strokeColor=#82b366;strokeWidth=3;fontSize=22;spacingTop=4;" value="&lt;span style=&quot;font-weight: 700;&quot;&gt;Torre de control&lt;/span&gt;" vertex="1">
          <mxGeometry height="345" width="3360" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;1 · Ingesta y consolidación&lt;/b&gt;&lt;br&gt;Recibe eventos y cargas. Idempotencia, orden y ventana para datos que llegan tarde." vertex="1">
          <mxGeometry height="115" width="630" x="30" y="78" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;2 · Correlación y contexto&lt;/b&gt;&lt;br&gt;Arma la vista del caso con llave única, y lo agrupa bajo su siniestro padre." vertex="1">
          <mxGeometry height="115" width="630" x="685" y="78" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;3 · Medición y evaluación&lt;/b&gt;&lt;br&gt;Indicadores del negocio y de acertividad por agente, cada uno con su ficha y su fórmula." vertex="1">
          <mxGeometry height="115" width="630" x="1340" y="78" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;4 · Decisión y actuación&lt;/b&gt;&lt;br&gt;Alertas con dueño y plazo, marcos de actuación, escalamientos y acciones operativas." vertex="1">
          <mxGeometry height="115" width="630" x="1995" y="78" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;5 · Exposición&lt;/b&gt;&lt;br&gt;Tableros por actor, notificaciones, productos de datos y la API de autonomía." vertex="1">
          <mxGeometry height="115" width="630" x="2650" y="78" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C4 · Semáforo de grados de autonomía&lt;/b&gt;&lt;br&gt;G1 en calibración, modo shadow · G2 supervisado · G3 autónomo con umbral · G4 pleno con auditoría por muestreo. Por agente y tipo de caso, con la distancia al siguiente grado calculada aquí y no reportada por el equipo del agente. Sin registro de decisión con su evidencia, la API no acepta el cambio de grado." vertex="1">
          <mxGeometry height="108" width="1600" x="30" y="212" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;C1 · Salud técnica del ecosistema&lt;/b&gt;&lt;br&gt;Disponibilidad y latencia de cada fuente que un agente consulta, rezago del bus y cobertura de emisión. Separa «el agente se equivocó» de «la fuente que consultó estaba caída»." vertex="1">
          <mxGeometry height="108" width="810" x="1660" y="212" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" value="&lt;b&gt;La frontera&lt;/b&gt;&lt;br&gt;La torre puede cambiar cómo se mueve una solicitud; no qué se decidió sobre ella. Cuando ejecuta, lo hace con identidad propia, alcance de escritura mínimo y registro por acción." vertex="1">
          <mxGeometry height="108" width="780" x="2500" y="212" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;verticalAlign=middle;" value="&lt;b&gt;C1 · Bus de eventos compartido — la torre suscrita a la totalidad de los eventos&lt;/b&gt;&lt;br&gt;Un evento por cada cambio de estado · llave de correlación del caso y del siniestro padre · esquema publicado y versionado con compatibilidad hacia atrás, y el emisor que no lo cumple queda rechazado y registrado como falla del emisor · ingesta idempotente · ventana para la evidencia que llega semanas después.&lt;br&gt;&lt;i&gt;Retención en dos horizontes: la traza técnica vive lo que dure el diagnóstico de un incidente; el registro que sustenta si una decisión estuvo bien, hasta que llegue la glosa o la reclamación.&lt;/i&gt;" vertex="1">
          <mxGeometry height="145" width="3360" y="400" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="n12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;jettySize=auto;labelBackgroundColor=#FFFFFF;fontSize=11;strokeColor=#B9720A;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="n3" value="">
