        <mxCell id="n196" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#5B5A66;" value="¿Esto nos baja la glosa y el fraude, o solo nos acelera?" vertex="1">
