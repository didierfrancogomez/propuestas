<mxfile host="app.diagrams.net" agent="Tech and Solve" version="29.6.1" type="device">
  <diagram name="Resumen Arq gestores" id="resumen-arq-gestores-propuesto">
    <mxGraphModel dx="4000" dy="3000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="&lt;b&gt;Resumen Arq gestores — cómo debería quedar&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="0" y="-215" width="3360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Sobre la vista que el equipo viene refinando, esta es la versión que proponemos. En gris y color, su diseño vigente: ningún gestor cambia de responsabilidad y ninguna pieza cambia de lugar. En &lt;b&gt;ámbar&lt;/b&gt;, los siete complementos que proponemos, C1 a C7. En &lt;b&gt;naranja&lt;/b&gt;, los nombres y las formas que conviene replantear.&lt;br&gt;Cada decisión de esta lámina está sustentada en las notas de arquitectura que la acompañan, y todas son debatibles: cada una se puede tomar, ajustar o descartar sin que se caigan las demás. · Tech and Solve para SURA, septiembre de 2026." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="0" y="-155" width="3360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;span style=&quot;font-weight: 700;&quot;&gt;Torre de control&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#d5e8d4;verticalAlign=top;align=center;strokeColor=#82b366;strokeWidth=3;fontSize=22;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="3360" height="345" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Front" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2960" y="14" width="175" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Back" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3150" y="14" width="175" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;1 · Ingesta y consolidación&lt;/b&gt;&lt;br&gt;Recibe eventos y cargas. Idempotencia, orden y ventana para datos que llegan tarde." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="78" width="630" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;2 · Correlación y contexto&lt;/b&gt;&lt;br&gt;Arma la vista del caso con llave única, y lo agrupa bajo su siniestro padre." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="685" y="78" width="630" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;3 · Medición y evaluación&lt;/b&gt;&lt;br&gt;Indicadores del negocio y de acertividad por agente, cada uno con su ficha y su fórmula." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1340" y="78" width="630" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;4 · Decisión y actuación&lt;/b&gt;&lt;br&gt;Alertas con dueño y plazo, marcos de actuación, escalamientos y acciones operativas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1995" y="78" width="630" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;5 · Exposición&lt;/b&gt;&lt;br&gt;Tableros por actor, notificaciones, productos de datos y la API de autonomía." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2650" y="78" width="630" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;C4 · Semáforo de grados de autonomía&lt;/b&gt;&lt;br&gt;G1 en calibración, modo shadow · G2 supervisado · G3 autónomo con umbral · G4 pleno con auditoría por muestreo. Por agente y tipo de caso, con la distancia al siguiente grado calculada aquí y no reportada por el equipo del agente. Sin registro de decisión con su evidencia, la API no acepta el cambio de grado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="212" width="1600" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;C1 · Salud técnica del ecosistema&lt;/b&gt;&lt;br&gt;Disponibilidad y latencia de cada fuente que un agente consulta, rezago del bus y cobertura de emisión. Separa «el agente se equivocó» de «la fuente que consultó estaba caída»." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1660" y="212" width="810" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;La frontera&lt;/b&gt;&lt;br&gt;La torre puede cambiar cómo se mueve una solicitud; no qué se decidió sobre ella. Cuando ejecuta, lo hace con identidad propia, alcance de escritura mínimo y registro por acción." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2500" y="212" width="780" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;C1 · Bus de eventos compartido — la torre suscrita a la totalidad de los eventos&lt;/b&gt;&lt;br&gt;Un evento por cada cambio de estado · llave de correlación del caso y del siniestro padre · esquema publicado y versionado con compatibilidad hacia atrás, y el emisor que no lo cumple queda rechazado y registrado como falla del emisor · ingesta idempotente · ventana para la evidencia que llega semanas después.&lt;br&gt;&lt;i&gt;Retención en dos horizontes: la traza técnica vive lo que dure el diagnóstico de un incidente; el registro que sustenta si una decisión estuvo bien, hasta que llegue la glosa o la reclamación.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="400" width="3360" height="145" as="geometry" />
        </mxCell>
